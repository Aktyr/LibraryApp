# Скопировать в .env и заменить на свои значения.
# Файл .env не коммитится (см. .gitignore).

# Минимум 32 символа (валидатор JwtSettings.MinLength).
JWT_SECRET_KEY=replace-me-with-a-strong-secret-at-least-32-chars

# Пароль seed-админа. Минимум 8 символов + заглавная/строчная/цифра/спецсимвол.
ADMIN_PASSWORD=ChangeMe123!
