@* Универсальная обёртка для модальных окон с заголовком и кнопкой закрытия *@
@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="OnClose"></div>
    <div class="modal-dialog @Class" @onclick:stopPropagation="true">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">@Title</h3>
            <button type="button" class="btn-close" @onclick="OnClose" aria-label="Закрыть"></button>
        </div>

        @ChildContent

        @if (Footer != null)
        {
            <div class="mt-3 text-end">
                @Footer
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
}