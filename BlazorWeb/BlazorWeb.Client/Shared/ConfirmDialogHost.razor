@using BlazorWeb.Client.Services.Interfaces
@implements IDisposable
@inject IConfirmService Confirm

@if (Confirm.IsVisible)
{
    <div class="modal-backdrop" @onclick="Confirm.Cancel"></div>
    <div class="modal-dialog" @onclick:stopPropagation="true">
        <h3 class="mb-3">@Confirm.CurrentTitle</h3>
        <p style="white-space: pre-line;">@Confirm.CurrentMessage</p>

        @if (Confirm.CurrentRequiresWord)
        {
            <div class="mb-3">
                <label class="form-label">
                    Для подтверждения введите <code>@Confirm.CurrentWord</code>:
                </label>
                <input type="text"
                       class="form-control"
                       @bind="_input"
                       @bind:event="oninput"
                       placeholder="@Confirm.CurrentWord"
                       autocomplete="off"
                       spellcheck="false" />
            </div>
        }

        <div class="mt-4">
            <button class="btn btn-@Confirm.CurrentButtonClass"
                    @onclick="Confirm.Confirm"
                    disabled="@(!CanConfirm)">
                @Confirm.CurrentConfirmText
            </button>
            <button class="btn btn-secondary ms-2" @onclick="Confirm.Cancel">
                @Confirm.CurrentCancelText
            </button>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        z-index: 2000;
    }

    .modal-dialog {
        z-index: 2001;
    }
</style>

@code {
    private string _input = "";

    private bool CanConfirm =>
        !Confirm.CurrentRequiresWord
        || string.Equals(_input.Trim(), Confirm.CurrentWord, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Confirm.OnChange += HandleChange;

    public void Dispose() => Confirm.OnChange -= HandleChange;

    private void HandleChange()
    {
        _input = "";
        InvokeAsync(StateHasChanged);
    }
}