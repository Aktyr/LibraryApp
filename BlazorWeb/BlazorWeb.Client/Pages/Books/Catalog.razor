@page "/catalog"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using BlazorWeb.Client.Shared.BookCard
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Requests.Search
@using Microsoft.AspNetCore.Authorization
@inject IBookApiClient BookClient
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>Каталог книг</PageTitle>

<div class="catalog-header">
    <h1>Каталог</h1>
    <p class="text-muted">Найдите нужную книгу и проверьте её наличие в фонде.</p>
</div>

<div class="catalog-filters">
    <div class="search-box">
        <input type="search"
               class="form-control"
               placeholder="Поиск по названию, автору, издательству..."
               @bind="request.Query"
               @bind:event="onchange"
               @bind:after="() => LoadAsync(false)" />
    </div>

    <div class="filter-group">
        <select class="form-select" value="@request.SortBy" @onchange="OnSortByChanged">
            <option value="Title">По названию</option>
            <option value="Author">По автору</option>
            <option value="Year">По году</option>
            <option value="popularity">По популярности</option>
        </select>

        <select class="form-select" value="@request.SortDescending.ToString().ToLower()" @onchange="OnSortDescendingChanged">
            <option value="false">По возрастанию</option>
            <option value="true">По убыванию</option>
        </select>
    </div>

    <div class="form-check form-switch ms-auto">
        <input class="form-check-input" type="checkbox" id="availCheck"
               @bind="request.AvailableOnly" @bind:after="() => LoadAsync(false)" />
        <label class="form-check-label" for="availCheck">Только в наличии</label>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Поиск книг...</p>
    </div>
}
else if (books == null || books.Count == 0)
{
    <div class="alert alert-info mt-4">
        <h4 class="alert-heading">Ничего не найдено</h4>
        <p class="mb-0">Попробуйте изменить поисковый запрос или снять фильтры.</p>
    </div>
}
else
{
    <div class="catalog-grid">
        @foreach (var book in books)
        {
            <BookCard Book="book" OnClick="OpenBookDetails" />
        }
    </div>

    @if (books.Count < totalCount)
    {
        <div class="text-center mt-4 mb-5">
            <button class="btn btn-outline-primary px-4 py-2" @onclick="LoadMoreAsync" disabled="@isLoadingMore">
                @if (isLoadingMore)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Загрузка...</span>
                }
                else
                {
                    <span>Показать ещё</span>
                }
            </button>
        </div>
    }
}

@code {
    #region Состояние компонента
    private bool isLoading = true;
    private bool isLoadingMore = false;
    private List<BookDTO> books = new();

    private int totalCount = 0;
    private int currentPage = 1;
    private const int PageSize = 20;

    private SearchBooksRequest request = new()
    {
        SortBy = "Title",
        SortDescending = false,
        AvailableOnly = false,
        PageNumber = 1,
        PageSize = PageSize
    };
    #endregion

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(append: false);
    }

    private void OpenBookDetails(BookDTO book)
    {
        Nav.NavigateTo($"/catalog/{book.Id}");
    }

    private async Task OnSortByChanged(ChangeEventArgs e)
    {
        request.SortBy = e.Value?.ToString();
        await LoadAsync(false);
    }

    private async Task OnSortDescendingChanged(ChangeEventArgs e)
    {
        // Явно парсим строку "true" или "false" обратно в bool
        request.SortDescending = bool.Parse(e.Value?.ToString() ?? "false");
        await LoadAsync(false);
    }

    private async Task LoadAsync(bool append)
    {
        if (append)
        {
            isLoadingMore = true;
        }
        else
        {
            isLoading = true;
            currentPage = 1;
        }

        await InvokeAsync(StateHasChanged);

        try
        {
            request.PageNumber = currentPage;
            var resp = await BookClient.SearchBooksAsync(request);

            totalCount = resp.TotalCount;

            if (append)
            {
                books.AddRange(resp.Book);
            }
            else
            {
                books = resp.Book.ToList();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки каталога: {ex.Message}");
            if (!append)
            {
                books = new();
            }
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadMoreAsync()
    {
        currentPage++;
        await LoadAsync(append: true);
    }
}