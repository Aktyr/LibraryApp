@page "/books"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using BlazorWeb.Client.Shared.CharCounter
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Records
@using LibApp.Core.Requests.Entities.Book
@inject IBookApiClient ApiClient
@inject IConfirmService Confirm
@inject AuthenticationStateProvider AuthProvider
@inject IToastService Toast

<PageTitle>Книги</PageTitle>

<PageHeader OnRefresh="LoadAsync" IsLoading="@isLoading" />

<h1>Библиотечный фонд</h1>

@if (isLoading)
{
    <p>Загрузка данных...</p>
}
else if (books != null)
{
    <DataGrid TItem="BookDTO"
              Items="books"
              PageSize="10"
              Columns="columns"
              Actions="actions"
              OnRowDoubleClick="OpenDetailsAsync" />
}

@* Модалка создания/редактирования *@
@if (dialogMode is DialogMode.Create or DialogMode.Edit)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>

    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>@(dialogMode == DialogMode.Create ? "Новая книга" : "Редактирование книги")</h3>

                <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Название <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.Title?.Length ?? 0)" Max="@BookPolicy.MaxTitleLength" />
                </div>
                <InputTextLive @bind-Value="draft.Title" class="form-control" />
                <ValidationMessage For="() => draft.Title" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Автор <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.Author?.Length ?? 0)" Max="@BookPolicy.MaxAuthorLength" />
                </div>
                <InputTextLive @bind-Value="draft.Author" class="form-control" />
                <ValidationMessage For="() => draft.Author" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Год <span class="text-danger">*</span></label>
                <InputNumber @bind-Value="draft.Year" class="form-control" />
                <ValidationMessage For="() => draft.Year" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Издательство <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.Publisher?.Length ?? 0)" Max="@BookPolicy.MaxPublisherLength" />
                </div>
                <InputTextLive @bind-Value="draft.Publisher" class="form-control" />
                <ValidationMessage For="() => draft.Publisher" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Жанр</label>
                    <CharCounter Current="@(draft.Genre?.Length ?? 0)" Max="@BookPolicy.MaxGenreLength" />
                </div>
                <InputTextLive @bind-Value="draft.Genre" class="form-control" />
                <ValidationMessage For="() => draft.Genre" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">URL обложки</label>
                    <CharCounter Current="@(draft.CoverUrl?.Length ?? 0)" Max="@BookPolicy.MaxCoverUrlLength" />
                </div>
                <InputTextLive @bind-Value="draft.CoverUrl" class="form-control" placeholder="https://..." />
                <ValidationMessage For="() => draft.CoverUrl" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Описание</label>
                    <CharCounter Current="@(draft.Description?.Length ?? 0)" Max="@BookPolicy.MaxDescriptionLength" />
                </div>
                <InputTextAreaLive @bind-Value="draft.Description" class="form-control" rows="4" />
                <ValidationMessage For="() => draft.Description" class="text-danger" />
            </div>

            @if (!string.IsNullOrWhiteSpace(dialogError))
            {
                <div class="alert alert-danger mb-3" style="white-space: pre-line;">@dialogError</div>
            }
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseDialog">Отмена</button>
        </EditForm>
    </div>
}

@* Модалка «Подробнее» *@
@if (dialogMode == DialogMode.Details && detailsBook != null)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>

    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>@detailsBook.Title</h3>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                @if (!string.IsNullOrWhiteSpace(detailsBook.CoverUrl))
                {
                    <img src="@detailsBook.CoverUrl"
                         alt="Обложка «@detailsBook.Title»"
                         style="max-width: 100%; max-height: 400px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" />
                }
                else
                {
                    <div style="display: flex; align-items: center; justify-content: center;
                        width: 100%; height: 200px; background: #f3f3f3;
                        border-radius: 6px; color: #888; font-size: 14px;">
                        Нет обложки
                    </div>
                }
            </div>
            <div class="col-md-8">
                <p class="mb-2"><strong>Автор:</strong> @detailsBook.Author</p>
                <p class="mb-2"><strong>Год:</strong> @detailsBook.Year</p>
                <p class="mb-2"><strong>Издательство:</strong> @detailsBook.Publisher</p>
                @if (!string.IsNullOrWhiteSpace(detailsBook.Genre))
                {
                    <p class="mb-2"><strong>Жанр:</strong> @detailsBook.Genre</p>
                }

                @if (!string.IsNullOrWhiteSpace(detailsBook.Description))
                {
                    <hr />
                    <p style="white-space: pre-wrap;">@detailsBook.Description</p>
                }
                else
                {
                    <hr />
                    <p class="text-muted">Описание не добавлено.</p>
                }
            </div>
        </div>

        <div class="mt-4">
            <button class="btn btn-secondary" @onclick="CloseDialog">Закрыть</button>
        </div>
    </div>
}

@code {
    private List<BookDTO>? books;
    private bool isLoading = true;

    private enum DialogMode { None, Create, Edit, Details }
    private DialogMode dialogMode = DialogMode.None;
    private Guid? editingId;
    private BookDraft draft = new();
    private BookDTO? detailsBook;
    private string? dialogError;

    private readonly List<DataGridColumn<BookDTO>> columns = new()
    {
        new() { Title = "Название", Value = b => b.Title, Width = 300 },
        new() { Title = "Автор", Value = b => b.Author, Width = 250 },
        new() { Title = "Год", Value = b => b.Year, FilterKind = FilterKind.Number, Width = 100 },
        new() { Title = "Жанр", Value = b => b.Genre, Width = 200 }
    };

    private List<DataGridAction<BookDTO>> actions = new();
    private bool isEditor;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        isEditor = auth.User.IsInRole("Librarian") || auth.User.IsInRole("Admin");

        ConfigureActions();
        await LoadAsync();
    }

    private void ConfigureActions()
    {
        // «Подробнее» — для всех: read-only операция.
        actions = new()
        {
            new()
            {
                Label = "Подробнее",
                Icon = "ℹ️",
                MinSelection = 1,
                CanExecute = s => s.Count == 1,
                Handler = s => OpenDetailsAsync(s[0])
            }
        };

        if (!isEditor)
            return;

        actions.Add(new()
        {
            Label = "Добавить",
            Icon = "➕",
            MinSelection = 0,
            ShowInContextMenu = false,
            Handler = _ => OpenCreateDialogAsync()
        });
        actions.Add(new()
        {
            Label = "Редактировать",
            Icon = "✏️",
            CanExecute = s => s.Count == 1,
            Handler = s => OpenEditDialogAsync(s[0])
        });
        actions.Add(new()
        {
            Label = "Удалить",
            Icon = "🗑️",
            SeparatorBefore = true,
            CanExecute = s => s.Count == 1 && s[0].RoomBook is not { Count: > 0 },
            Handler = s => DeleteAsync(s[0])
        });
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var resp = await ApiClient.GetAllBooksAsync();
            books = resp.Book.ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenCreateDialogAsync()
    {
        dialogMode = DialogMode.Create;
        editingId = null;
        draft = new BookDraft { Year = DateTime.UtcNow.Year };
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditDialogAsync(BookDTO book)
    {
        dialogMode = DialogMode.Edit;
        editingId = book.Id;
        draft = new BookDraft
        {
            Title = book.Title,
            Author = book.Author,
            Year = book.Year,
            Publisher = book.Publisher,
            Genre = book.Genre,
            Description = book.Description,
            CoverUrl = book.CoverUrl
        };
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenDetailsAsync(BookDTO book)
    {
        detailsBook = book;
        dialogMode = DialogMode.Details;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        dialogMode = DialogMode.None;
        editingId = null;
        detailsBook = null;
        dialogError = null;
    }

    private async Task SaveAsync()
    {
        dialogError = null;
        try
        {
            if (dialogMode == DialogMode.Create)
            {
                await ApiClient.CreateBookAsync(new CreateBookRequest
                {
                    Title = draft.Title,
                    Author = draft.Author,
                    Year = draft.Year,
                    Publisher = draft.Publisher,
                    Genre = draft.Genre,
                    Description = draft.Description,
                    CoverUrl = draft.CoverUrl
                });
                Toast.ShowSuccess($"Книга «{draft.Title}» добавлена");
            }
            else if (dialogMode == DialogMode.Edit && editingId.HasValue)
            {
                await ApiClient.UpdateBookAsync(new UpdateBookRequest
                {
                    Id = new Id(editingId.Value),
                    Title = draft.Title,
                    Author = draft.Author,
                    Year = draft.Year,
                    Publisher = draft.Publisher,
                    Genre = draft.Genre,
                    Description = draft.Description,
                    CoverUrl = draft.CoverUrl
                });
                Toast.ShowSuccess($"Книга «{draft.Title}» обновлена");
            }
            CloseDialog();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    private async Task DeleteAsync(BookDTO book)
    {
        // Проверка до модалки. Если удалить нельзя — не мучаем пользователя вводом слова
        if (book.RoomBook is { Count: > 0 })
        {
            Toast.ShowError($"Нельзя удалить книгу «{book.Title}»: она есть в {book.RoomBook.Count} комнате(ах). " +
                           "Сначала уберите её из всех комнат.");
            return;
        }

        var confirmed = await Confirm.AskAsync(
            $"Удалить книгу «{book.Title}»?\nАвтор: {book.Author}\n\nЭто действие необратимо.",
            title: "Удаление книги",
            confirmText: "Удалить",
            requireConfirmationWord: true);

        if (!confirmed) return;

        try
        {
            await ApiClient.DeleteBookAsync(book.Id);
            Toast.ShowSuccess($"Книга «{book.Title}» удалена");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка удаления: {ex.Message}");
        }
    }

    private class BookDraft : IValidatableObject
    {
        [Required(ErrorMessage = "Название обязательно")]
        public string Title { get; set; } = "";

        [Required(ErrorMessage = "Автор обязателен")]
        public string Author { get; set; } = "";

        public int Year { get; set; }

        [Required(ErrorMessage = "Издательство обязательно")]
        public string Publisher { get; set; } = "";

        public string Genre { get; set; } = "";
        public string Description { get; set; } = "";
        public string CoverUrl { get; set; } = "";

        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            var errors = BookPolicy.Validate(Title, Author, Year, Publisher, Genre, Description, CoverUrl);
            foreach (var error in errors)
            {
                // Ошибки BookPolicy приходят без привязки к полю. Привязываем вручную —
                // иначе ValidationMessage ниже не покажет их пользователю.
                string[]? memberNames = error switch
                {
                    _ when error.Contains("Год") => [nameof(Year)],
                    _ when error.Contains("Описание") => [nameof(Description)],
                    _ when error.Contains("URL обложки") => [nameof(CoverUrl)],
                    _ => null
                };
                yield return new ValidationResult(error, memberNames);
            }
        }
    }
}