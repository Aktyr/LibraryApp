@page "/my-profile"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Client.Shared.CharCounter
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Borrowing
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Enums
@using LibApp.Core.Policies
@using LibApp.Core.Records
@using Microsoft.AspNetCore.Authorization
@inject IUserApiClient UserClient
@inject IBorrowRequestApiClient BorrowRequestClient
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IConfirmService Confirm
@inject IToastService Toast
@inject IBorrowingSettingsService SettingsService

<PageTitle>Мой профиль</PageTitle>

<PageHeader OnRefresh="LoadAsync" IsLoading="@isLoading">
    <ChildContent>
        @if (user != null)
        {
            <button class="btn btn-sm btn-outline-secondary"
                    @onclick="OpenEditDialog"
                    disabled="@isLoading">
                ✏️ Редактировать профиль
            </button>
            <a class="btn btn-sm btn-outline-secondary" href="Account/Manage">
                🔐 Безопасность
            </a>
            @if (user.Role != UserRole.Admin)
            {
                <span title="@DeleteAccountBlockReason" style="display: inline-block;">
                    <button class="btn btn-sm btn-outline-danger"
                            @onclick="DeleteAccountAsync"
                            disabled="@(isLoading || !CanDeleteAccount)">
                        🗑️ Удалить аккаунт
                    </button>
                </span>
            }
        }
    </ChildContent>
</PageHeader>
@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (user == null)
{
    <div class="alert alert-warning">Не удалось загрузить данные профиля. Возможно, ваша учетная запись удалена.</div>
}
else
{
    <div class="mb-3 pb-3 border-bottom">
        <h2 class="mb-1">@FullName</h2>
        <div class="text-muted">
            <span>@user.Email</span>
            <span class="mx-2">·</span>
            @Badges.Role(user.Role)
            <span class="mx-2">·</span>
            <span>@Badges.Status(user.SubscriptionStatus)</span>
        </div>
    </div>

    @if (user.SubscriptionStatus != SubscriptionStatus.Active)
    {
        <div class="alert alert-warning py-2 mb-4">
            ⚠️ Ваш Профиль <strong>@(user.SubscriptionStatus == SubscriptionStatus.Unconfirmed ? "не подтверждён" : "заморожен")</strong>.
            Выдача новых книг временно приостановлена.
        </div>
    }

    <div class="mb-3 d-flex gap-4 align-items-start flex-wrap">
        <div>
            <small class="text-muted d-block">Активных выдач</small>
            <span class="fs-5 fw-semibold">@user.ActiveBorrowedCount / @MaxBooksPerUser</span>
        </div>
        <div>
            <small class="text-muted d-block">Просрочено</small>
            <span class="fs-5 fw-semibold @(overdueCount > 0 ? "text-danger" : "")">@overdueCount</span>
        </div>
        <div>
            <small class="text-muted d-block">Штрафы</small>
            <span class="fs-5 fw-semibold @(totalPenalty > 0 ? "text-danger" : "")">@totalPenalty.ToString("0.##") ₽</span>
        </div>
    </div>

    <div class="mb-4">
        <h4>Мои заявки (@myRequests.Count)</h4>
        @if (myRequests.Count == 0)
        {
            <p class="text-muted">Заявок на выдачу нет.</p>
        }
        else
        {
            <DataGrid TItem="BorrowRequestDTO"
                      Items="myRequests"
                      PageSize="10"
                      Columns="RequestColumns"
                      Actions="RequestActions"
                      Hint="<b>Отменить</b> — доступно для ожидающих и забронированных заявок | <b>Забронирована</b> — книга ждёт вас в библиотеке до указанного срока | <b>Выдана</b> — книга на руках, см. раздел «Мои активные книги»"
                      SelectionMode="DataGridSelectionMode.Multiple" />
        }
    </div>

    @if (returnedBorrows.Count > 0)
    {
        <details class="mb-4">
            <summary class="h5" style="cursor: pointer;">История возвратов (@returnedBorrows.Count)</summary>
            <div class="mt-2">
                <DataGrid TItem="BorrowedBookDTO"
                          Items="returnedBorrows"
                          PageSize="10"
                          Columns="HistoryColumns"
                          SelectionMode="DataGridSelectionMode.Multiple" />
            </div>
        </details>
    }
}
@* Модалка редактирования профиля *@
@if (editDialogOpen)
{
    <div class="modal-backdrop" @onclick="CloseEditDialog"></div>
    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>Редактирование профиля</h3>
        <EditForm Model="draft" OnValidSubmit="SaveProfileAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Фамилия <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.LastName?.Length ?? 0)" Max="@UserPolicy.MaxNameLength" />
                </div>
                <InputTextLive @bind-Value="draft.LastName" class="form-control" />
                <ValidationMessage For="() => draft.LastName" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Имя <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.FirstName?.Length ?? 0)" Max="@UserPolicy.MaxNameLength" />
                </div>
                <InputTextLive @bind-Value="draft.FirstName" class="form-control" />
                <ValidationMessage For="() => draft.FirstName" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Отчество</label>
                    <CharCounter Current="@(draft.MiddleName?.Length ?? 0)" Max="@UserPolicy.MaxNameLength" />
                </div>
                <InputTextLive @bind-Value="draft.MiddleName" class="form-control" />
                <ValidationMessage For="() => draft.MiddleName" class="text-danger" />
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Контактная информация <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.ContactInfo?.Length ?? 0)" Max="@UserPolicy.MaxContactInfoLength" />
                </div>
                <InputTextLive @bind-Value="draft.ContactInfo" class="form-control" />
                <ValidationMessage For="() => draft.ContactInfo" class="text-danger" />
            </div>

            @if (!string.IsNullOrEmpty(editError))
            {
                <div class="alert alert-danger mb-3" style="white-space: pre-line;">@editError</div>
            }

            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseEditDialog">Отмена</button>
        </EditForm>
    </div>
}
@code {
    private string FullName => user.FullName();
    private List<BorrowedBookDTO> activeBorrows => allBorrows.ActiveBorrows();
    private List<BorrowedBookDTO> returnedBorrows => allBorrows.ReturnedBorrows();
    private int overdueCount => activeBorrows.OverdueCount();
    private decimal totalPenalty => allBorrows.TotalPenalty();

    private readonly List<DataGridColumn<BorrowedBookDTO>> ActiveColumns =
        UserBorrowsColumns.CreateActive(penaltyDisplay: b => b.Penalty ?? 0m);
    private readonly List<DataGridColumn<BorrowedBookDTO>> HistoryColumns =
        UserBorrowsColumns.CreateHistory();

    private List<DataGridColumn<BorrowRequestDTO>>? _requestColumns;
    private List<DataGridColumn<BorrowRequestDTO>> RequestColumns => _requestColumns ??= new()
    {
        new() { Title = "Книга", Value = r => r.BookTitle, Width = 240 },
        new() { Title = "Автор", Value = r => r.BookAuthor, Width = 180 },
        new() { Title = "Комната", Value = r => r.RoomName, Width = 140 },
        new()
        {
            Title = "Создана",
            Width = 150,
            FilterKind = FilterKind.Date,
            Value = r => r.CreatedAt,
            FilterText = r => r.CreatedAt.ToString("yyyy-MM-dd"),
            Template = item => b => b.AddContent(0, item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
        },
        new()
        {
            Title = "Статус",
            Width = 140,
            Value = r => r.Status.DisplayName(),
            FilterText = r => r.Status.DisplayName(),
            Template = item => b =>
            {
                var (bg, fg) = BorrowRequestStatusStyle.Get(item.Status);
                b.OpenElement(0, "span");
                b.AddAttribute(1, "style",
                    $"background:{bg};color:{fg};padding:2px 10px;border-radius:10px;font-size:12px;");
                b.AddContent(2, item.Status.DisplayName());
                b.CloseElement();
            }
        },
        new()
        {
            // Только у Approved. Читатель видит, до какого момента книга ждёт его в библиотеке.
            Title = "Забрать до",
            Width = 150,
            FilterKind = FilterKind.Date,
            Value = r => r.ExpiresAt,
            FilterText = r => r.ExpiresAt?.ToString("yyyy-MM-dd") ?? "",
            Template = item => b => b.AddContent(0,
                item.ExpiresAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
        },
        new()
        {
            Title = "Обработана",
            Width = 150,
            FilterKind = FilterKind.Date,
            Value = r => r.ProcessedAt,
            FilterText = r => r.ProcessedAt?.ToString("yyyy-MM-dd") ?? "",
            Template = item => b => b.AddContent(0,
                item.ProcessedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
        },
        new()
        {
            Title = "Комментарий",
            Width = 260,
            Value = r => r.Comment ?? "",
            FilterText = r => r.Comment ?? ""
        }
    };

    private List<DataGridAction<BorrowRequestDTO>>? _requestActions;
    private List<DataGridAction<BorrowRequestDTO>> RequestActions => _requestActions ??= new()
    {
        new()
        {
            Label = "Отменить заявку",
            Icon = "🚫",
            MinSelection = 1,
            CanExecute = s => s.Count == 1
                && (s[0].Status == BorrowRequestStatus.Pending
                    || s[0].Status == BorrowRequestStatus.Approved),
            Handler = s => CancelRequestAsync(s[0])
        }
    };

    private bool isLoading = true;
    private UserDTO? user;
    private List<BorrowedBookDTO> allBorrows = new();
    private List<BorrowRequestDTO> myRequests = new();

    private BorrowingSettingsDTO? settings;
    private int MaxBooksPerUser => settings?.MaxBooksPerUser ?? 5;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private bool editDialogOpen;
    private UserDraft draft = new();
    private string? editError;

    private async Task OpenEditDialog()
    {
        if (user == null) return;
        draft = new UserDraft
        {
            LastName = user.LastName,
            FirstName = user.FirstName,
            MiddleName = user.MiddleName,
            ContactInfo = user.ContactInfo
        };
        editError = null;
        editDialogOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseEditDialog()
    {
        editDialogOpen = false;
        editError = null;
    }

    private async Task SaveProfileAsync()
    {
        if (user == null) return;
        editError = null;
        try
        {
            await UserClient.UpdateUserAsync(new UpdateUserRequest
            {
                Id = new Id(user.Id),
                LastName = draft.LastName,
                FirstName = draft.FirstName,
                MiddleName = draft.MiddleName,
                ContactInfo = draft.ContactInfo
            });
            Toast.ShowSuccess("Профиль обновлён");
            CloseEditDialog();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            editError = ex.Message;
        }
    }

    private int UnpaidPenaltyCount => allBorrows.Count(b => b.Penalty is > 0 && !b.IsPenaltyPaid);

    private bool CanDeleteAccount =>
        user != null
        && user.ActiveBorrowedCount == 0
        && UnpaidPenaltyCount == 0;

    private string DeleteAccountBlockReason
    {
        get
        {
            if (user == null) return "";
            if (user.ActiveBorrowedCount > 0)
                return $"Нельзя удалить: {user.ActiveBorrowedCount} активных выдач. Сначала верните все книги.";
            if (UnpaidPenaltyCount > 0)
                return $"Нельзя удалить: {UnpaidPenaltyCount} неоплаченных штрафов. Обратитесь к библиотекарю.";
            return "Удалить аккаунт";
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (user == null || !CanDeleteAccount) return;


        var confirmed = await Confirm.AskAsync(
            "Удалить аккаунт?\n\n" +
            "Аккаунт будет деактивирован, вы выйдете из системы. " +
            "Восстановить можно в любой момент по email и паролю на странице входа.\n\n" +
            "История выдач и штрафов сохранится.",
            title: "Удаление аккаунта",
            confirmText: "Удалить",
            requireConfirmationWord: true,
            confirmationWord: "УДАЛИТЬ");

        if (!confirmed) return;

        try
        {
            var resp = await UserClient.DeleteMyProfileAsync();
            Toast.ShowSuccess(resp.Message);
            // forceLoad: полный reload, чтобы сбросить WASM-состояние и cookie Identity.
            Nav.NavigateTo("/Account/Login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка удаления: {ex.Message}");
        }
    }

    private class UserDraft
    {
        [Required(ErrorMessage = "Фамилия обязательна")]
        [StringLength(UserPolicy.MaxNameLength, ErrorMessage = "Не более 100 символов")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Имя обязательно")]
        [StringLength(UserPolicy.MaxNameLength, ErrorMessage = "Не более 100 символов")]
        public string FirstName { get; set; } = "";

        [StringLength(UserPolicy.MaxNameLength, ErrorMessage = "Не более 100 символов")]
        public string MiddleName { get; set; } = "";

        [Required(ErrorMessage = "Контактная информация обязательна")]
        [StringLength(UserPolicy.MaxContactInfoLength, ErrorMessage = "Не более 200 символов")]
        public string ContactInfo { get; set; } = "";
    }    

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            settings = await SettingsService.GetAsync();
            var resp = await UserClient.GetMeAsync();
            user = resp.Users.FirstOrDefault();

            if (user != null)
            {
                var booksResp = await UserClient.GetMyBooksAsync();
                allBorrows = booksResp.Books.ToList();

                // Заявки читателя. PageSize 100 — с запасом: за один заход больше
                // не бывает, для UI-списка «Мои заявки» этого достаточно.
                // Отдельный запрос — чтобы не грузить заявки вместе с выдачами в одном
                // ответе: API-контракты у них разные, склейка на сервере смешала бы слои.
                var requestsResp = await BorrowRequestClient.GetMyAsync(new GetBorrowRequestsRequest
                {
                    PageNumber = 1,
                    PageSize = 100
                });
                myRequests = requestsResp.Data.ToList();
            }

        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки профиля: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task CancelRequestAsync(BorrowRequestDTO request)
    {
        // Текст зависит от статуса: для Pending читатель отменяет ожидание,
        // для Approved — освобождает забронированный экземпляр.
        var message = request.Status == BorrowRequestStatus.Approved
            ? $"Отменить бронь на книгу «{request.BookTitle}»?\n\nЗабронированный экземпляр вернётся в фонд, и его сможет взять другой читатель."
            : $"Отменить заявку на книгу «{request.BookTitle}»?";

        var confirmed = await Confirm.AskAsync(
            message,
            title: "Отмена заявки",
            confirmText: "Отменить заявку",
            cancelText: "Не отменять");

        if (!confirmed) return;

        try
        {
            var resp = await BorrowRequestClient.CancelAsync(
                request.Id, new CancelBorrowRequest());
            Toast.ShowSuccess(resp.Message);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка отмены: {ex.Message}");
        }
    }
}