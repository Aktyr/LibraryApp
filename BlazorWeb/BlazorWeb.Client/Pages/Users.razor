@page "/users"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Enums
@using LibApp.Core.Records
@using LibApp.Core.Requests.Entities.User
@using Microsoft.AspNetCore.Authorization
@inject IUserApiClient ApiClient
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Пользователи</PageTitle>

<h1>Пользователи</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}

@if (isLoading)
{
    <p>Загрузка данных...</p>
}
else if (users != null)
{
    <DataGrid TItem="UserDTO"
              Items="users"
              PageSize="10"
              Columns="columns"
              Actions="actions"
              StatusMessage="@statusMessage"
              OnRowDoubleClick="OnUserDoubleClick" />
}

@if (dialogMode != DialogMode.None)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>

    <div class="modal-dialog" @onclick:stopPropagation="true">
        <h3>@(dialogMode == DialogMode.Create ? "Новый пользователь" : "Редактирование пользователя")</h3>
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (dialogMode == DialogMode.Create)
            {
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="draft.Email" class="form-control" type="email" />
                    <ValidationMessage For="() => draft.Email" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <InputText @bind-Value="draft.Password" class="form-control" type="password" />
                    <ValidationMessage For="() => draft.Password" class="text-danger" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Фамилия</label>
                <InputText @bind-Value="draft.LastName" class="form-control" />
                <ValidationMessage For="() => draft.LastName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Имя</label>
                <InputText @bind-Value="draft.FirstName" class="form-control" />
                <ValidationMessage For="() => draft.FirstName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Отчество</label>
                <InputText @bind-Value="draft.MiddleName" class="form-control" />
                <ValidationMessage For="() => draft.MiddleName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Контактная информация</label>
                <InputText @bind-Value="draft.ContactInfo" class="form-control" />
                <ValidationMessage For="() => draft.ContactInfo" class="text-danger" />
            </div>

            @if (dialogMode == DialogMode.Create)
            {
                <div class="mb-3">
                    <label class="form-label">Роль</label>
                    <select class="form-select" @bind="draft.Role">
                        <option value="@UserRole.Reader">Читатель</option>
                        <option value="@UserRole.Librarian">Библиотекарь</option>
                        <option value="@UserRole.Admin">Администратор</option>
                    </select>
                </div>
            }

            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseDialog">Отмена</button>

            @if (!string.IsNullOrWhiteSpace(dialogError))
            {
                <div class="alert alert-danger mt-3" style="white-space: pre-line;">@dialogError</div>
            }
        </EditForm>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 1000;
        cursor: default; /* Курсор не меняется на "руку" */
    }

    .modal-dialog {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
        background: #fff;
        border-radius: 8px;
        padding: 20px 24px;
        min-width: 480px;
        max-width: 90vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        /* ВАЖНО: переопределяем Bootstrap, чтобы клики не проходили на фон */
        pointer-events: auto;
    }
</style>

@code {
    // todo: брать из BorrowingSettings (WebAPI appsettings), когда появится клиентская конфигурация
    private const int MaxBooks = 5;

    private List<UserDTO>? users;
    private bool isLoading = true;
    private string? errorMessage;
    private string? statusMessage;

    private enum DialogMode { None, Create, Edit }
    private DialogMode dialogMode = DialogMode.None;
    private Guid? editingId;
    private UserDraft draft = new();
    private string? dialogError;

    private readonly List<DataGridColumn<UserDTO>> columns = new()
    {
        new()
        {
            Title = "ФИО",
            Width = 280,
            Value = u => $"{u.LastName} {u.FirstName} {u.MiddleName}".Trim(),
            FilterText = u => $"{u.LastName} {u.FirstName} {u.MiddleName}".Trim()
        },
        new()
        {
            Title = "Роль",
            Width = 140,
            Value = u => u.Role,
            FilterText = u => RoleName(u.Role),
            Template = u => b =>
            {
                var (bg, fg, text) = u.Role switch
                {
                    UserRole.Admin => ("#fde7e9", "#a30000", "Администратор"),
                    UserRole.Librarian => ("#e6f0fb", "#003a6b", "Библиотекарь"),
                    _ => ("#f3f3f3", "#555", "Читатель")
                };
                b.OpenElement(0, "span");
                b.AddAttribute(1, "style",
                    $"background:{bg};color:{fg};padding:2px 10px;border-radius:10px;font-size:12px;");
                b.AddContent(2, text);
                b.CloseElement();
            }
        },
        new()
        {
            Title = "На руках",
            Width = 110,
            FilterKind = FilterKind.Number,
            Value = u => u.ActiveBorrowedCount,
            FilterText = u => u.ActiveBorrowedCount.ToString(),
            Template = u => b =>
            {
                var count = u.ActiveBorrowedCount;
                var color = count >= MaxBooks ? "#a30000"
                          : count >= MaxBooks - 1 ? "#a85b00"
                          : "#333";
                var weight = count >= MaxBooks ? "600" : "400";
                b.OpenElement(0, "span");
                b.AddAttribute(1, "style", $"color:{color};font-weight:{weight};");
                b.AddContent(2, $"{count} / {MaxBooks}");
                b.CloseElement();
            }
        },
        new()
        {
            Title = "Контакт",
            Width = 220,
            Value = u => u.ContactInfo
        },
        new()
        {
            Title = "Ближайший возврат",
            Width = 170,
            FilterKind = FilterKind.Number,
            Value = u => u.NearestReturnTimeSpan.HasValue
                ? (int)u.NearestReturnTimeSpan.Value.TotalDays
                : (int?)null,
            FilterText = u => u.NearestReturnTimeSpan.HasValue
                ? $"{(int)u.NearestReturnTimeSpan.Value.TotalDays}"
                : "",
            Template = u => b =>
            {
                if (!u.NearestReturnTimeSpan.HasValue)
                {
                    b.AddContent(0, "—");
                    return;
                }
                var days = (int)u.NearestReturnTimeSpan.Value.TotalDays;
                if (days < 0)
                {
                    b.OpenElement(0, "span");
                    b.AddAttribute(1, "style", "color:#a30000;font-weight:600;");
                    b.AddContent(2, $"⚠ {-days} дн. просрочено");
                    b.CloseElement();
                }
                else
                {
                    b.AddContent(0, $"{days} дн.");
                }
            }
        }
    };

    private List<DataGridAction<UserDTO>> actions = new();

    protected override async Task OnInitializedAsync()
    {
        ConfigureActions();
        await LoadAsync();
    }

    private void ConfigureActions()
    {
        actions = new()
        {
            new()
            {
                Label = "Добавить",
                Icon = "➕",
                MinSelection = 0,
                ShowInContextMenu = false,
                Handler = _ => OpenCreateDialogAsync()
            },
            new()
            {
                Label = "Профиль",
                Icon = "📖",
                CanExecute = s => s.Count == 1,
                Handler = s => { Nav.NavigateTo($"/users/{s[0].Id}"); return Task.CompletedTask; }
            },
            new()
            {
                Label = "Редактировать",
                Icon = "✏️",
                CanExecute = s => s.Count == 1,
                Handler = s => OpenEditDialogAsync(s[0])
            },
            new()
            {
                Label = "Удалить",
                Icon = "🗑️",
                SeparatorBefore = true,
                CanExecute = s => s.Count == 1,
                Handler = s => DeleteAsync(s[0])
            }
        };
    }

    private void OnUserDoubleClick(UserDTO user) => Nav.NavigateTo($"/users/{user.Id}");

    private static string RoleName(UserRole role) => role switch
    {
        UserRole.Admin => "Администратор",
        UserRole.Librarian => "Библиотекарь",
        _ => "Читатель"
    };

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var resp = await ApiClient.GetAllUsersAsync();
            users = resp.Users.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        dialogMode = DialogMode.Create;
        editingId = null;
        draft = new UserDraft { Role = UserRole.Reader };
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditDialogAsync(UserDTO user)
    {
        dialogMode = DialogMode.Edit;
        editingId = user.Id;
        draft = new UserDraft
        {
            LastName = user.LastName,
            FirstName = user.FirstName,
            MiddleName = user.MiddleName,
            ContactInfo = user.ContactInfo
        };
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        dialogMode = DialogMode.None;
        editingId = null;
        dialogError = null;
    }

    private async Task SaveAsync()
    {
        dialogError = null;
        try
        {
            if (dialogMode == DialogMode.Create)
            {
                await ApiClient.CreateUserAsync(new CreateUserRequest
                {
                    Email = draft.Email,
                    Password = draft.Password,
                    LastName = draft.LastName,
                    FirstName = draft.FirstName,
                    MiddleName = draft.MiddleName,
                    ContactInfo = draft.ContactInfo,
                    Role = draft.Role
                });
                statusMessage = $"Пользователь «{draft.LastName} {draft.FirstName}» добавлен";
            }
            else if (dialogMode == DialogMode.Edit && editingId.HasValue)
            {
                await ApiClient.UpdateUserAsync(new UpdateUserRequest
                {
                    Id = new Id(editingId.Value),
                    LastName = draft.LastName,
                    FirstName = draft.FirstName,
                    MiddleName = draft.MiddleName,
                    ContactInfo = draft.ContactInfo
                });
                statusMessage = $"Пользователь «{draft.LastName} {draft.FirstName}» обновлён";
            }
            CloseDialog();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    private async Task DeleteAsync(UserDTO user)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Удалить пользователя «{user.LastName} {user.FirstName}»?");
        if (!confirmed) return;

        try
        {
            await ApiClient.DeleteUserAsync(user.Id);
            statusMessage = $"Пользователь «{user.LastName} {user.FirstName}» удалён";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка удаления: {ex.Message}";
        }
    }

    private class UserDraft : System.ComponentModel.DataAnnotations.IValidatableObject
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email обязателен")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Некорректный email")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Пароль обязателен")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 8, ErrorMessage = "Пароль от 8 до 100 символов")]
        public string Password { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Фамилия обязательна")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Не более 100 символов")]
        public string LastName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Имя обязательно")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Не более 100 символов")]
        public string FirstName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Не более 100 символов")]
        public string MiddleName { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Контактная информация обязательна")]
        [System.ComponentModel.DataAnnotations.StringLength(200, ErrorMessage = "Не более 200 символов")]
        public string ContactInfo { get; set; } = "";

        public UserRole? Role { get; set; } = UserRole.Reader;

        public IEnumerable<System.ComponentModel.DataAnnotations.ValidationResult> Validate(
            System.ComponentModel.DataAnnotations.ValidationContext validationContext)
        {
            // Совпадает с UserValidatorAsync.ValidatePasswordAsync на сервере.
            // Показываем первую непройденную проверку — как сервер.
            if (string.IsNullOrEmpty(Password) || Password.Length < 8 || Password.Length > 100)
                yield break; // базовые [Required]/[StringLength] уже показали ошибку

            if (!System.Text.RegularExpressions.Regex.IsMatch(Password, @"[A-Z]"))
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Пароль должен содержать хотя бы одну заглавную букву",
                    new[] { nameof(Password) });
                yield break;
            }
            if (!System.Text.RegularExpressions.Regex.IsMatch(Password, @"[a-z]"))
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Пароль должен содержать хотя бы одну строчную букву",
                    new[] { nameof(Password) });
                yield break;
            }
            if (!System.Text.RegularExpressions.Regex.IsMatch(Password, @"[0-9]"))
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Пароль должен содержать хотя бы одну цифру",
                    new[] { nameof(Password) });
                yield break;
            }
            if (!System.Text.RegularExpressions.Regex.IsMatch(Password, @"[!@#$%^&*(),.?"":{}|<>]"))
            {
                yield return new System.ComponentModel.DataAnnotations.ValidationResult(
                    "Пароль должен содержать хотя бы один спецсимвол",
                    new[] { nameof(Password) });
            }
        }
    }
}