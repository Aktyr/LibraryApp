@page "/rooms"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Requests.Entities.Room
@using BlazorWeb.Client.Shared.CharCounter
@inject IRoomApiClient ApiClient
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject IToastService Toast

<PageTitle>Комнаты</PageTitle>

<PageHeader OnRefresh="LoadAsync" IsLoading="@isLoading" />

<h1>Комнаты</h1>

@if (isLoading)
{
    <p>Загрузка данных...</p>
}
else if (rooms != null)
{
    <DataGrid TItem="RoomDTO"
              Items="rooms"
              PageSize="10"
              Columns="columns"
              Actions="actions"
              OnRowDoubleClick="OnRoomDoubleClick" />
}

@* Модалка создания комнаты *@
@if (dialogMode == DialogMode.Create)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>
    <div class="modal-dialog" @onclick:stopPropagation="true">
        <h3>Новая комната</h3>
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label">Название <span class="text-danger">*</span></label>
                    <CharCounter Current="@(draft.Name?.Length ?? 0)" Max="@RoomPolicy.MaxNameLength" />
                </div>
                <InputTextLive @bind-Value="draft.Name" class="form-control" />
                <ValidationMessage For="() => draft.Name" class="text-danger" />
            </div>            @if (!string.IsNullOrWhiteSpace(dialogError))
            {
                <div class="alert alert-danger mb-3" style="white-space: pre-line;">@dialogError</div>
            }
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseDialog">Отмена</button>
        </EditForm>
    </div>
}

@code {
    private List<RoomDTO>? rooms;
    private bool isLoading = true;

    private enum DialogMode { None, Create }
    private DialogMode dialogMode = DialogMode.None;
    private RoomDraft draft = new();
    private string? dialogError;

    private readonly List<DataGridColumn<RoomDTO>> columns = new()
    {
        new() { Title = "Название комнаты", Value = r => r.Name, Width = 300 },
        new()
        {
            Title = "Всего книг",
            Value = r => r.RoomBook?.Sum(rb => rb.BookCount) ?? 0,
            FilterKind = FilterKind.Number,
            Width = 120
        },
        new()
        {
            Title = "Выдано",
            Value = r => r.RoomBook?.Sum(rb => rb.BorrowedCount) ?? 0,
            FilterKind = FilterKind.Number,
            Width = 100,
            Template = item => b =>
            {
                var borrowed = item.RoomBook?.Sum(rb => rb.BorrowedCount) ?? 0;
                if (borrowed > 0) {
                    b.OpenElement(0, "span");
                    b.AddAttribute(1, "style", "color:#a85b00;font-weight:600;");
                    b.AddContent(2, borrowed.ToString());
                    b.CloseElement();
                } else {
                    b.AddContent(0, "0");
                }
            }
        },
        new()
        {
            Title = "Доступно",
            Value = r => (r.RoomBook?.Sum(rb => rb.BookCount) ?? 0) - (r.RoomBook?.Sum(rb => rb.BorrowedCount) ?? 0),
            FilterKind = FilterKind.Number,
            Width = 120,
            Template = item => b =>
            {
                var total = item.RoomBook?.Sum(rb => rb.BookCount) ?? 0;
                var borrowed = item.RoomBook?.Sum(rb => rb.BorrowedCount) ?? 0;
                var available = total - borrowed;
                var color = available == 0 ? "#a30000" : available < total ? "#a85b00" : "#0a7f2e";
                b.OpenElement(0, "span");
                b.AddAttribute(1, "style", $"color:{color};font-weight:600;");
                b.AddContent(2, available.ToString());
                b.CloseElement();
            }
        }
    };

    private List<DataGridAction<RoomDTO>> actions = new();
    private bool isEditor;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        isEditor = auth.User.IsInRole("Librarian") || auth.User.IsInRole("Admin");

        ConfigureActions();
        await LoadAsync();
    }

    private void ConfigureActions()
    {
        if (!isEditor)
        {
            actions = new(); // пусто = нет кнопок
            return;
        }

        actions = new()
        {
            new() { Label = "Добавить", Icon = "➕", MinSelection = 0, ShowInContextMenu = false, Handler = _ => OpenCreateDialogAsync() },
            new() { Label = "Открыть", Icon = "📖", CanExecute = s => s.Count == 1, Handler = s => { Nav.NavigateTo($"/rooms/{s[0].Id}"); return Task.CompletedTask; } }
        };
    }

    private void OnRoomDoubleClick(RoomDTO room) => Nav.NavigateTo($"/rooms/{room.Id}");

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var resp = await ApiClient.GetAllRoomsAsync();
            rooms = resp.Room.ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenCreateDialogAsync()
    {
        dialogMode = DialogMode.Create;
        draft = new RoomDraft();
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        dialogMode = DialogMode.None;
        dialogError = null;
    }

    private async Task SaveAsync()
    {
        dialogError = null;
        try
        {
            await ApiClient.CreateRoomAsync(new CreateRoomRequest(draft.Name, []));
            Toast.ShowSuccess($"Комната «{draft.Name}» добавлена");
            CloseDialog();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    private class RoomDraft : IValidatableObject
    {
        public string Name { get; set; } = "";

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            foreach (var error in RoomPolicy.Validate(Name))
                yield return new ValidationResult(error, [nameof(Name)]);
        }
    }
}