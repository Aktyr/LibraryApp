@page "/debug"
@rendermode InteractiveWebAssembly
@using BlazorWeb.Components.Shared.DataGrid

<PageTitle>Debug — тестовая таблица</PageTitle>

<h1>Debug: тестовая таблица</h1>

<div style="margin-bottom:12px; display:flex; gap:12px; align-items:center;">
    <button @onclick="() => counter++" style="padding:6px 12px;">
        Counter: @counter
    </button>
    <button @onclick="ResetData" style="padding:6px 12px;">🔄 Сбросить</button>
    <span>Всего: <b>@items.Count</b></span>
    <span style="color:@(initDone ? "#0a7f2e" : "#a30000");">
        Init: @(initDone ? "OK" : "NOT INITIALIZED")
    </span>
</div>

<DataGrid TItem="TestItem"
          Items="items"
          Columns="columns"
          Actions="actions"
          SelectionMode="DataGridSelectionMode.Multiple"
          PageSize="15"
          StatusMessage="@statusMessage" /> @* Отвечает за синую сноску с действиями *@

@code {
    public class TestItem
    {
        public int Id { get; set; }  // детерминированный ID
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public int Number { get; set; }
        public decimal Price { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private List<TestItem> items = new();
    private string? statusMessage;
    private bool initDone;
    private int counter;
    private List<DataGridColumn<TestItem>> columns = new();
    private List<DataGridAction<TestItem>> actions = new();

    protected override void OnInitialized()
    {
        Console.WriteLine("[Debug] OnInitialized");
        GenerateData();
        ConfigureColumns();
        ConfigureActions();
        initDone = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Console.WriteLine($"[Debug] First render on client, items={items.Count}, columns={columns.Count}");
    }

    private void GenerateData()
    {
        items = new List<TestItem>();
        var categories = new[] { "Книги", "Журналы", "Газеты", "Учебники", "Справочники" };
        var names = new[] { "Война и мир", "Преступление и наказание", "Мастер и Маргарита",
                            "Отцы и дети", "Анна Каренина", "Идиот", "Братья Карамазовы" };
        var rnd = new Random(42);
        for (int i = 0; i < 47; i++)
        {
            items.Add(new TestItem
            {
                Id = i + 1,
                Name = $"{names[rnd.Next(names.Length)]} #{i + 1}",
                Category = categories[rnd.Next(categories.Length)],
                Number = rnd.Next(1, 1000),
                Price = Math.Round((decimal)(rnd.NextDouble() * 2000), 2),
                IsActive = rnd.Next(3) > 0,
                CreatedAt = new DateTime(2024, 1, 1).AddDays(rnd.Next(0, 365))
            });
        }
        statusMessage = $"Данные: {items.Count} записей";
    }

    private void ConfigureColumns()
    {
        columns = new()
        {
            new() { Title = "№", Width = 70, FilterKind = FilterKind.Number,
                    Value = x => x.Id, FilterText = x => x.Id.ToString() },
            new() { Title = "Название", Width = 260, FilterKind = FilterKind.Text,
                    Value = x => x.Name },
            new() { Title = "Категория", Width = 140, FilterKind = FilterKind.Text,
                    Value = x => x.Category },
            new() { Title = "Цена, ₽", Width = 110, FilterKind = FilterKind.Number,
                    Value = x => x.Price, FilterText = x => x.Price.ToString("F2") },
            new() { Title = "Активна", Width = 120, FilterKind = FilterKind.Bool,
                    Value = x => x.IsActive },
            new() { Title = "Создано", Width = 130, FilterKind = FilterKind.Date,
                    Value = x => x.CreatedAt,
                    FilterText = x => x.CreatedAt.ToString("yyyy-MM-dd"),
                    Template = item => b => b.AddContent(0, item.CreatedAt.ToString("dd.MM.yyyy")) },
        };
    }

    private void ConfigureActions()
    {
        actions = new()
        {
            new() { Label = "Редактировать", 
                    Icon = "✏️", 
                    MinSelection = 1,
                    CanExecute = sel => sel.Count == 1,
                    Handler = async sel => { statusMessage = $"✏️ {sel[0].Name}"; await Task.CompletedTask; } },

            new() { Label = "Удалить", 
                    Icon = "🗑️", 
                    MinSelection = 1, 
                    SeparatorBefore = true,
                    Handler = HandleDelete },

            new() { Label = "Активировать", 
                    Icon = "✓", 
                    MinSelection = 1,
                    CanExecute = sel => sel.Any(x => !x.IsActive),
                    Handler = HandleActivate }
        };
    }

    private async Task HandleDelete(IReadOnlyList<TestItem> sel)
    {
        var ids = sel.Select(x => x.Id).ToHashSet();
        items = items.Where(x => !ids.Contains(x.Id)).ToList();
        statusMessage = $"🗑️ Удалено: {sel.Count}. Осталось: {items.Count}";
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task HandleActivate(IReadOnlyList<TestItem> sel)
    {
        var ids = sel.Select(x => x.Id).ToHashSet();
        items = items.Select(x =>
        {
            if (ids.Contains(x.Id) && !x.IsActive) x.IsActive = true;
            return x;
        }).ToList();
        statusMessage = $"✓ Активировано: {sel.Count}";
        await Task.CompletedTask;
    }

    private void ResetData()
    {
        GenerateData();
        StateHasChanged();
    }
}