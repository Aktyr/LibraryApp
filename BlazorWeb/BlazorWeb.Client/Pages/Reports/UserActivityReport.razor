@page "/reports/user-activity"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Reports
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IReportsApiClient ReportsClient
@inject IToastService Toast

<PageTitle>Активность пользователей</PageTitle>

<PageHeader BackUrl="/reports" OnRefresh="LoadAsync" IsLoading="@isLoading">
    <ChildContent>
        <div class="d-flex align-items-center gap-3 ms-auto">
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="chkOverdue" @bind="onlyWithOverdue" @bind:after="LoadAsync" />
                <label class="form-check-label" for="chkOverdue">Только должники</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="chkActive" @bind="onlyActive" @bind:after="LoadAsync" />
                <label class="form-check-label" for="chkActive">Только с активными книгами</label>
            </div>
        </div>
    </ChildContent>
</PageHeader>

<h2>Активность пользователей</h2>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (userActivity != null)
{
    <DataGrid TItem="UserActivityReportDTO"
              Items="userActivity"
              PageSize="15"
              Columns="columns"
              SelectionMode="DataGridSelectionMode.Multiple" />
}

@code {
    private bool isLoading = true;
    private List<UserActivityReportDTO>? userActivity;

    private bool onlyWithOverdue = false;
    private bool onlyActive = false;

    private readonly List<DataGridColumn<UserActivityReportDTO>> columns = new()
    {
        new() { Title = "Пользователь", Value = u => u.FullName, Width = 250 },
        new() { Title = "Email", Value = u => u.Email, Width = 220 },
        new() { Title = "Всего выдач", Value = u => u.TotalBorrowedCount, Width = 120, FilterKind = FilterKind.Number },
        new() { Title = "Сейчас на руках", Value = u => u.CurrentBorrowedCount, Width = 150, FilterKind = FilterKind.Number },
        new() { Title = "Штрафы", Value = u => u.TotalPenalty, Width = 100, FilterKind = FilterKind.Number },
        new() { Title = "Есть просрочки", Value = u => u.HasOverdue, Width = 140, FilterKind = FilterKind.Bool }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var resp = await ReportsClient.GetUserActivityAsync(onlyWithOverdue, onlyActive);
            userActivity = resp.Data.ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }
}