@page "/reports/popular-books"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Reports
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Librarian,Admin")]
@inject IReportsApiClient ReportsClient
@inject IToastService Toast

<PageTitle>Популярные книги</PageTitle>

<PageHeader BackUrl="/reports" OnRefresh="LoadAsync" IsLoading="@isLoading" />

<h2>Популярные книги</h2>

@if (isLoading && popularBooks == null)
{
    <p>Загрузка...</p>
}
else if (popularBooks != null)
{
    <DataGrid TItem="BookPopularityReportDTO"
              Items="popularBooks"
              PageSize="15"
              Columns="columns"
              FilterColumns="filterColumns"
              OnFiltersChanged="OnFiltersChanged"
              IsLoading="isLoading"
              SelectionMode="DataGridSelectionMode.Multiple" />
}

@code {
    private bool isLoading = true;
    private List<BookPopularityReportDTO>? popularBooks;

    private DateTime? fromDate;
    private DateTime? toDate;

    private readonly List<DataGridColumn<BookPopularityReportDTO>> columns = new()
    {
        new() { Title = "Название", Value = b => b.Title, Width = 300 },
        new() { Title = "Автор", Value = b => b.Author, Width = 220 },
        new() { Title = "Всего выдач", Value = b => b.TotalBorrowedCount, Width = 120, FilterKind = FilterKind.Number },
        new() { Title = "Сейчас на руках", Value = b => b.CurrentBorrowedCount, Width = 150, FilterKind = FilterKind.Number }
    };

    // Период живёт в чип-фильтре и уходит на сервер: строки отчёта — агрегаты,
    // клиентская фильтрация по дате их не пересчитает.
    private readonly List<DataGridColumn<BookPopularityReportDTO>> filterColumns = new()
    {
        new()
        {
            Id = "period",
            Title = "Период",
            FilterKind = FilterKind.Date,
            Sortable = false,
            DefaultFilterOperator = FilterOperator.Between
        }
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var resp = await ReportsClient.GetPopularBooksAsync(fromDate: fromDate, toDate: toDate);
            popularBooks = resp.Data.ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFiltersChanged(IReadOnlyList<FilterClause> clauses)
    {
        var (from, to) = clauses.GetDateRange("period");
        if (from == fromDate && to == toDate) return;

        fromDate = from;
        toDate = to;
        await LoadAsync();
    }
}
