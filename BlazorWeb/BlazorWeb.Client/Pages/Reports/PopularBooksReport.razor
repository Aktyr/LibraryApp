@page "/reports/popular-books"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Reports
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IReportsApiClient ReportsClient
@inject IToastService Toast

<PageTitle>Популярные книги</PageTitle>

<PageHeader BackUrl="/reports" OnRefresh="LoadAsync" IsLoading="@isLoading">
    <ChildContent>
        <div class="d-flex align-items-center gap-2 ms-auto">
            <label class="small text-muted mb-0">За период с:</label>
            <input type="date" class="form-control form-control-sm" style="width: 140px;"
                   @bind="FromDate" @bind:after="LoadAsync" />
            <label class="small text-muted mb-0">по:</label>
            <input type="date" class="form-control form-control-sm" style="width: 140px;"
                   @bind="ToDate" @bind:after="LoadAsync" />
        </div>
    </ChildContent>
</PageHeader>

<h2>Популярные книги</h2>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (popularBooks != null)
{
    <DataGrid TItem="BookPopularityReportDTO"
              Items="popularBooks"
              PageSize="15"
              Columns="columns"
              SelectionMode="DataGridSelectionMode.Multiple" />
}

@code {
    private bool isLoading = true;
    private List<BookPopularityReportDTO>? popularBooks;

    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }

    private readonly List<DataGridColumn<BookPopularityReportDTO>> columns = new()
    {
        new() { Title = "Название", Value = b => b.Title, Width = 300 },
        new() { Title = "Автор", Value = b => b.Author, Width = 220 },
        new() { Title = "Всего выдач", Value = b => b.TotalBorrowedCount, Width = 120, FilterKind = FilterKind.Number },
        new() { Title = "Сейчас на руках", Value = b => b.CurrentBorrowedCount, Width = 150, FilterKind = FilterKind.Number }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var resp = await ReportsClient.GetPopularBooksAsync(fromDate: FromDate, toDate: ToDate);
            popularBooks = resp.Data.ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }
}