@page "/reports/discards"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Librarian,Admin")]
@inject IBookApiClient BookClient
@inject IToastService Toast

<PageTitle>Отчёт по списаниям</PageTitle>

<PageHeader BackUrl="/reports" OnRefresh="LoadAsync" IsLoading="@isLoading">
    <ChildContent>
        <div class="d-flex align-items-center gap-2 ms-auto">
            <label class="small text-muted mb-0">За период с:</label>
            <input type="date" class="form-control form-control-sm" style="width: 140px;"
                   @bind="FromDate" @bind:after="LoadAsync" />
            <label class="small text-muted mb-0">по:</label>
            <input type="date" class="form-control form-control-sm" style="width: 140px;"
                   @bind="ToDate" @bind:after="LoadAsync" />
        </div>
    </ChildContent>
</PageHeader>

<h2>Списания</h2>

@if (isLoading)
{
    <p>Загрузка...</p>
}
@* ---------- Счётчики (по всем загруженным записям, не по фильтру DataGrid) ---------- *@
else if (records != null)
{
    <div class="d-flex gap-4 mb-3">
        <div>
            <small class="text-muted d-block">Всего списаний</small>
            <span class="fs-5 fw-semibold">@records.Count</span>
        </div>
        <div>
            <small class="text-muted d-block">Всего экземпляров</small>
            <span class="fs-5 fw-semibold">@records.Sum(r => r.Amount)</span>
        </div>
        <div>
            <small class="text-muted d-block">Сумма компенсаций</small>
            <span class="fs-5 fw-semibold @(totalCompensation > 0 ? "text-danger" : "")">
                @totalCompensation.ToString("0.##") ₽
            </span>
        </div>
    </div>

    @if (records.Count == 0)
    {
        <p class="text-muted">За указанный период списаний нет.</p>
    }
    else
    {
        <DataGrid TItem="DiscardedBookDTO"
                  Items="records"
                  PageSize="20"
                  Columns="columns"
                  SelectionMode="DataGridSelectionMode.Multiple" />
    }
}

@code {
    private bool isLoading = true;
    private List<DiscardedBookDTO>? records;

    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }

    private decimal totalCompensation =>
        records?.Where(r => r.CompensationAmount.HasValue).Sum(r => r.CompensationAmount!.Value) ?? 0;

    private readonly List<DataGridColumn<DiscardedBookDTO>> columns = new()
    {
        new()
        {
            Title = "Дата",
            Width = 120,
            FilterKind = FilterKind.Date,
            Value = r => r.DiscardedDate,
            FilterText = r => r.DiscardedDate.ToString("yyyy-MM-dd"),
            Template = item => b => b.AddContent(0, item.DiscardedDate.ToLocalTime().ToString("dd.MM.yyyy"))
        },
        new() { Title = "Книга", Width = 240, Value = r => r.BookTitle },
        new() { Title = "Комната", Width = 160, Value = r => r.RoomName },
        new() { Title = "Кол-во", Width = 80, FilterKind = FilterKind.Number, Value = r => r.Amount },
        new()
        {
            Title = "Причина",
            Width = 140,
            Value = r => r.DiscardReason.DisplayName(),
            FilterText = r => r.DiscardReason.DisplayName(),
            Template = item => b =>
            {
                var (bg, fg) = item.DiscardReason switch
                {
                    DiscardReason.Wear     => ("#fff3d9", "#8a4b00"),
                    DiscardReason.Damaged  => ("#fde7e9", "#a30000"),
                    DiscardReason.Loss     => ("#fde7e9", "#a30000"),
                    DiscardReason.Obsolete => ("#f3f3f3", "#555"),
                    _                      => ("#f3f3f3", "#555")
                };
                b.OpenElement(0, "span");
                b.AddAttribute(1, "style", $"background:{bg};color:{fg};padding:2px 10px;border-radius:10px;font-size:12px;");
                b.AddContent(2, item.DiscardReason.DisplayName());
                b.CloseElement();
            }
        },
        new() { Title = "Списал", Width = 200, Value = r => r.ApprovedBy, FilterText = r => r.ApprovedBy ?? "" },
        new()
        {
            Title = "Компенсация, ₽",
            Width = 140,
            FilterKind = FilterKind.Number,
            Value = r => r.CompensationAmount,
            FilterText = r => r.CompensationAmount?.ToString("0.##") ?? "",
            Template = item => b =>
            {
                if (item.CompensationAmount.HasValue && item.CompensationAmount.Value > 0)
                {
                    b.OpenElement(0, "span");
                    b.AddAttribute(1, "style", "color:#a30000;font-weight:600;");
                    b.AddContent(2, $"{item.CompensationAmount.Value:0.##}");
                    b.CloseElement();
                }
                else
                {
                    b.AddContent(0, "—");
                }
            }
        }
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            // Фильтрация идёт на клиенте через DataGrid.
            // Если данных станет много — переключимся на серверную фильтрацию.
            var resp = await BookClient.GetDiscardedBooksAsync(fromDate: FromDate, toDate: ToDate);
            records = resp.Discarded.ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка загрузки: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }
}