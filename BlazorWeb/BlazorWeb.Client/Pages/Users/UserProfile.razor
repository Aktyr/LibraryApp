@page "/users/{Id:guid}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize(Roles = "Librarian,Admin")]
@using BlazorWeb.Client.Services.APIs
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Borrowing
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Enums
@using LibApp.Core.Interfaces
@using LibApp.Core.Records
@using LibApp.Core.Requests.Borrowing
@using LibApp.Core.Requests.Entities.User
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserApiClient UserClient
@inject IRoomApiClient RoomClient
@inject IBookApiClient BookClient
@inject IBorrowingApiClient BorrowingClient
@inject IConfirmService Confirm
@inject NavigationManager Nav
@inject IBorrowingSettingsService SettingsService
@inject AuthenticationStateProvider AuthProvider
@inject IToastService Toast
@inject IUserManagementPolicy Policy

<PageTitle>Профиль — @FullName</PageTitle>

@* ---------- Шапка ---------- *@
<PageHeader BackUrl="/users" OnRefresh="ReloadAsync" IsLoading="@isLoading">
    <ChildContent>
        @if (CanEdit)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="OpenEditDialogAsync" disabled="@isLoading">✏️ Редактировать</button>
        }
        @if (CanDelete)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="DeleteUserAsync" disabled="@isLoading">🗑️ Удалить</button>
        }
    </ChildContent>
</PageHeader>

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (user == null)
{
    <div class="alert alert-warning">
        Пользователь не найден. <a href="/users">Вернуться к списку</a>
    </div>
}
else
{
    @* ---------- Карточка: имя, email, роль ---------- *@
    <div class="mb-3 pb-3 border-bottom d-flex justify-content-between align-items-start">
        <div>
            <h2 class="mb-1">@FullName</h2>
            <div class="text-muted">
                <span>@user.Email</span>
                <span class="mx-2">·</span>
                @Badges.Role(user.Role)
            </div>
        </div>

        @* Выпадающий список для управления статусом *@
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small text-muted">Профиль:</label>
            <select class="form-select form-select-sm"
                    style="width: auto;"
                    @onchange="OnStatusChanged"
                    disabled="@isLoading">
                <option value="@SubscriptionStatus.Unconfirmed" selected="@(user.SubscriptionStatus == SubscriptionStatus.Unconfirmed)">
                    Не подтверждён
                </option>
                <option value="@SubscriptionStatus.Active" selected="@(user.SubscriptionStatus == SubscriptionStatus.Active)">
                    Активен
                </option>
                <option value="@SubscriptionStatus.Frozen" selected="@(user.SubscriptionStatus == SubscriptionStatus.Frozen)">
                    Заморожен
                </option>
            </select>
        </div>
    </div>

    @* ---------- Мини-дашборд ---------- *@
    <div class="mb-3 d-flex gap-4 align-items-start flex-wrap">
        <div>
            <small class="text-muted d-block">Активных выдач</small>
            <span class="fs-5 fw-semibold" style="color:@BorrowedColor">
                @user.ActiveBorrowedCount / @MaxBooksPerUser
            </span>
        </div>
        <div>
            <small class="text-muted d-block">Просрочено</small>
            <span class="fs-5 fw-semibold @(overdueCount > 0 ? "text-danger" : "")">
                @overdueCount
            </span>
        </div>
        <div>
            <small class="text-muted d-block">Всего за всё время</small>
            <span class="fs-5 fw-semibold">@allBorrows.Count</span>
        </div>
        <div>
            <small class="text-muted d-block">Штрафы</small>
            <span class="fs-5 fw-semibold @(totalPenalty > 0 ? "text-danger" : "")">
                @totalPenalty.ToString("0.##") ₽
            </span>
        </div>
    </div>

    <div class="mb-4 small text-muted">
        <span>Контакт:</span> <strong>@user.ContactInfo</strong>
    </div>

    @if (user.SubscriptionStatus != SubscriptionStatus.Active)
    {
        <div class="alert alert-danger py-2 mb-4">
            ⚠️ Профиль пользователя <strong>@(user.SubscriptionStatus == SubscriptionStatus.Unconfirmed ? "не подтверждён" : "заморожен")</strong>.
            Выдача новых книг заблокирована. Разблокируйте Профиль, чтобы продолжить выдачу.
        </div>
    }

    @* ---------- Активные выдачи ---------- *@
    <div class="mb-4">
        <h4>Активные выдачи (@activeBorrows.Count)</h4>
        @if (activeBorrows.Count == 0)
        {
            <p class="text-muted mb-0">Нет активных выдач.</p>
        }
        else
        {
            <DataGrid TItem="BorrowedBookDTO"
                      Items="activeBorrows"
                      PageSize="10"
                      Columns="ActiveColumns"
                      Actions="activeActions"
                      SelectionMode="DataGridSelectionMode.Multiple"
                      OnRowDoubleClick="OnActiveRowDoubleClick" />
        }
    </div>

    @* ---------- Доступные книги ---------- *@
    <div class="mb-4">
        <h4>Доступные книги для выдачи (@availableRoomBooks.Count)</h4>
        @if (user.ActiveBorrowedCount >= MaxBooksPerUser)
        {
            <p class="text-danger mb-0">
                Лимит книг на руках достигнут (@MaxBooksPerUser / @MaxBooksPerUser).
                Верните одну из книг, чтобы выдать новую.
            </p>
        }
        else if (overdueCount > 0)
        {
            <p class="text-danger mb-0">
                У пользователя есть просроченные книги. Выдача заблокирована до их возврата.
            </p>
        }
        else if (availableRoomBooks.Count == 0)
        {
            <p class="text-muted mb-0">Нет доступных книг в библиотеке.</p>
        }
        else
        {
            <DataGrid TItem="RoomBookOption"
                      Items="availableRoomBooks"
                      PageSize="10"
                      Columns="availableColumns"
                      Actions="availableActions"
                      SelectionMode="DataGridSelectionMode.Single"
                      OnRowDoubleClick="OpenBorrowDialog" />
        }
    </div>

    @* ---------- История возвратов (сворачиваемая) ---------- *@
    @if (returnedBorrows.Count > 0)
    {
        <details class="mb-4">
            <summary class="h5" style="cursor: pointer;">
                История возвратов (@returnedBorrows.Count)
                @if (totalPenalty > 0)
                {
                    <small class="text-danger fs-6 ms-2">· Штрафы: @totalPenalty.ToString("0.##") ₽</small>
                }
            </summary>
            <div class="mt-2">
                <DataGrid TItem="BorrowedBookDTO"
                          Items="returnedBorrows"
                          PageSize="10"
                          Columns="historyColumns"
                          SelectionMode="DataGridSelectionMode.None" />
            </div>
        </details>
    }
}

@* ---------- Модалка редактирования профиля ---------- *@
@if (dialogMode == DialogMode.Edit)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>

    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>Редактирование пользователя</h3>
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Фамилия <span class="text-danger">*</span></label>
                <InputText @bind-Value="draft.LastName" class="form-control" />
                <ValidationMessage For="() => draft.LastName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Имя <span class="text-danger">*</span></label>
                <InputText @bind-Value="draft.FirstName" class="form-control" />
                <ValidationMessage For="() => draft.FirstName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Отчество</label>
                <InputText @bind-Value="draft.MiddleName" class="form-control" />
                <ValidationMessage For="() => draft.MiddleName" class="text-danger" />
            </div>
            <div class="mb-3">
                <label class="form-label">Контактная информация <span class="text-danger">*</span></label>
                <InputText @bind-Value="draft.ContactInfo" class="form-control" />
                <ValidationMessage For="() => draft.ContactInfo" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseDialog">Отмена</button>

        </EditForm>
    </div>
}

@* ---------- Модалка выдачи ---------- *@
@if (borrowDialogOpen && borrowDialogBook != null)
{
    <div class="modal-backdrop" @onclick="CloseBorrowDialog"></div>
    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>Выдать книгу</h3>
        <p class="mb-3 text-muted small">
            @FullName — на руках <strong>@user!.ActiveBorrowedCount / @MaxBooksPerUser</strong>,
            после выдачи будет <strong>@(user.ActiveBorrowedCount + 1) / @MaxBooksPerUser</strong>
        </p>

        <div class="card mb-3">
            <div class="card-body py-2">
                <div><strong>@borrowDialogBook.BookTitle</strong></div>
                @if (!string.IsNullOrEmpty(borrowDialogBook.BookAuthor))
                {
                    <div class="text-muted small">@borrowDialogBook.BookAuthor</div>
                }
                <div class="text-muted small mt-1">
                    Комната: @borrowDialogBook.RoomName ·
                    доступно: @borrowDialogBook.Available из @borrowDialogBook.Total
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Вернуть до</label>
            <input type="date" class="form-control"
                   style="max-width: 200px;"
                   min="@MinBorrowDateIso" max="@MaxBorrowDateIso"
                   @bind="borrowDueDate" />
            <small class="text-muted">
                Срок: <strong>@BorrowDaysComputed</strong> дн.
                (от @MinBorrowDays до @MaxBorrowDays, сегодня @DateTime.Today.ToString("dd.MM.yyyy"))
            </small>
        </div>

        <div>
            <button class="btn btn-primary"
                    disabled="@(!CanSubmitBorrow)"
                    @onclick="SubmitBorrowAsync">
                Выдать
            </button>
            <button class="btn btn-secondary ms-2" @onclick="CloseBorrowDialog">Отмена</button>
        </div>
    </div>
}

@* ---------- Модалка продления ---------- *@
@if (extendingBorrow != null)
{
    <div class="modal-backdrop" @onclick="CloseExtend"></div>
    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>Продлить выдачу</h3>
        <p class="mb-1"><strong>@extendingBorrow.BookTitle</strong> — @extendingBorrow.RoomName</p>
        <p class="mb-1">Текущий срок: <strong>@(extendingBorrow.Deadline?.ToString("dd.MM.yyyy") ?? "—")</strong></p>
        <p class="mb-3">
            Продлено: <strong>@extendingBorrow.TotalExtendedDays</strong> из @MaxExtendDeadlineDays дн.
            (доступно ещё <strong>@MaxAvailableExtend</strong>)
        </p>
        @if (MaxAvailableExtend > 0)
        {
            <div class="mb-3">
                <label class="form-label">Дополнительно дней</label>
                <input type="number" class="form-control"
                       min="1" max="@MaxAvailableExtend"
                       style="width: 120px;"
                       @bind="extendDays" />
                <small class="text-muted">
                    Новый срок: @(NewDeadline?.ToString("dd.MM.yyyy") ?? "—")
                </small>
            </div>
        }
        else
        {
            <p class="text-danger">Лимит продлений исчерпан.</p>
        }
        <div>
            <button class="btn btn-primary"
                    disabled="@(!CanExtend)"
                    @onclick="ExtendAsync">
                Продлить
            </button>
            <button class="btn btn-secondary ms-2" @onclick="CloseExtend">Отмена</button>
        </div>
    </div>
}

@* ---------- Модалка возврата с осмотром ---------- *@
@if (returnDialogBorrow != null)
{
    <div class="modal-backdrop" @onclick="CloseReturnDialog"></div>
    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>Возврат книги</h3>
        <p class="mb-1"><strong>@returnDialogBorrow.BookTitle</strong> — @returnDialogBorrow.RoomName</p>
        <p class="mb-3 text-muted small">
            Срок возврата: @(returnDialogBorrow.Deadline?.ToString("dd.MM.yyyy") ?? "—")
        </p>

        <div class="mb-3">
            <label class="form-label fw-bold">Состояние книги</label>
            <select class="form-select"
                    value="@(returnReason?.ToString() ?? "")"
                    @onchange="OnReturnReasonChanged">
                <option value="">Ок — вернуть в фонд (без списания)</option>
                @foreach (var r in new[]
                {
                    DiscardReason.Wear, DiscardReason.Damaged, DiscardReason.Loss,
                    DiscardReason.Obsolete, DiscardReason.Other
                })
                {
                    var suffix = r == DiscardReason.Loss
                        ? " — списать, компенсация обязательна"
                        : " — списать";
                    <option value="@r">@r.DisplayName()@suffix</option>
                }
            </select>
        </div>

        @* Блок компенсации рендерится всегда, если выбрана ЛЮБАЯ причина списания. *@
        @if (returnReason != null)
        {
            <div class="mb-3">
                <label class="form-label">
                    Сумма компенсации, ₽
                    @if (returnReason == DiscardReason.Loss)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                <input type="number" class="form-control" style="max-width: 200px;"
                       step="0.01" min="0" @bind="returnCompensation" />
                <small class="text-muted">
                    @(returnReason == DiscardReason.Loss
                        ? "При утрате необходимо указать сумму (> 0)."
                        : "Опционально. Оставьте пустым, если компенсация не взимается.")
                </small>
            </div>

            <div class="alert alert-warning py-2 mb-3">
                ⚠️ Книга будет списана из фонда: экземпляр в комнате уменьшится на 1.
                Если это последний экземпляр во всех комнатах — книга помечается как «Списана».
            </div>
        }

        <div class="mt-4">
            <button class="btn btn-primary"
                    disabled="@(!CanSubmitReturn || returnDialogSaving)"
                    @onclick="SubmitReturnAsync">
                @(returnDialogSaving ? "Возврат..." : "Подтвердить возврат")
            </button>
            <button class="btn btn-secondary ms-2" @onclick="CloseReturnDialog" disabled="@returnDialogSaving">
                Отмена
            </button>
        </div>
    </div>
}

@code {
    private BorrowingSettingsDTO? settings;
    private int MaxBooksPerUser => settings?.MaxBooksPerUser ?? 5;
    private int MaxExtendDeadlineDays => settings?.MaxExtendDeadlineDays ?? 14;
    private int MinBorrowDays => settings?.MinBorrowDays ?? 1;
    private int MaxBorrowDays => settings?.MaxBorrowDays ?? 30;

    [Parameter] public Guid Id { get; set; }

    private bool isLoading = true;
    private string? errorMessage;

    private UserDTO? user;
    private UserRole actorRole;
    private List<BorrowedBookDTO> allBorrows = new();
    private List<RoomDTO> rooms = new();
    private Dictionary<Guid, BookDTO> bookById = new();

    // Модалка редактирования пользователя
    private enum DialogMode { None, Edit }
    private DialogMode dialogMode = DialogMode.None;
    private UserDraft draft = new();
    private string? dialogError;

    // Модалка выдачи
    private bool borrowDialogOpen;
    private RoomBookOption? borrowDialogBook;
    private DateTime borrowDueDate = DateTime.Today.AddDays(14);
    private string? borrowDialogError;

    // Модалка продления
    private BorrowedBookDTO? extendingBorrow;
    private int extendDays = 7;

    // Модалка возврата с осмотром
    private BorrowedBookDTO? returnDialogBorrow;
    private DiscardReason? returnReason;
    private decimal? returnCompensation;
    private string? returnDialogError;
    private bool returnDialogSaving;

    #region Вычисляемые свойства

    private List<BorrowedBookDTO> activeBorrows => allBorrows.ActiveBorrows();
    private List<BorrowedBookDTO> returnedBorrows => allBorrows.ReturnedBorrows();
    private int overdueCount => activeBorrows.OverdueCount();
    private decimal totalPenalty => allBorrows.TotalPenalty();
    private string FullName => user.FullName();

    private bool CanEdit => user != null && Policy.CanEdit(actorRole, user.Role);
    private bool CanDelete => user != null && Policy.CanDelete(actorRole);

    private List<DataGridColumn<BorrowedBookDTO>>? _activeColumns;
    private List<DataGridColumn<BorrowedBookDTO>> ActiveColumns => _activeColumns ??= UserBorrowsColumns.CreateActive(
        showBorrowDate: true,
        showExtendedDays: true,
        penaltyDisplay: b => b.Penalty ?? 0m,
        maxExtendDeadlineDays: MaxExtendDeadlineDays);

    private string BorrowedColor =>
        user == null ? "#333"
        : user.ActiveBorrowedCount >= MaxBooksPerUser ? "#a30000"
        : user.ActiveBorrowedCount >= MaxBooksPerUser - 1 ? "#a85b00"
        : "#333";

    private List<RoomBookOption> availableRoomBooks
    {
        get
        {
            if (user == null) return new();
            var takenTitles = activeBorrows.Select(b => b.BookTitle).ToHashSet();

            return (from r in rooms
                    from rb in r.RoomBook
                    where rb.BookCount - rb.BorrowedCount > 0
                    let book = bookById.GetValueOrDefault(rb.BookId)
                    let title = book?.Title ?? $"[{rb.BookId}]"
                    let author = book?.Author ?? ""
                    where !takenTitles.Contains(title)
                    let available = rb.BookCount - rb.BorrowedCount
                    select new RoomBookOption(rb.Id, title, author, r.Name, available, rb.BookCount))
                .OrderBy(o => o.BookTitle)
                .ThenBy(o => o.RoomName)
                .ToList();
        }
    }

    // ---- Выдача ----
    private string MinBorrowDateIso => DateTime.Today.ToString("yyyy-MM-dd");
    private string MaxBorrowDateIso => DateTime.Today.AddDays(MaxBorrowDays).ToString("yyyy-MM-dd");
    private int BorrowDaysComputed => (borrowDueDate.Date - DateTime.Today).Days;

    private bool CanSubmitBorrow =>
        borrowDialogBook != null
        && BorrowDaysComputed >= MinBorrowDays
        && BorrowDaysComputed <= MaxBorrowDays;

    // ---- Продление ----
    private int MaxAvailableExtend =>
        extendingBorrow == null ? 0
        : Math.Max(0, MaxExtendDeadlineDays - extendingBorrow.TotalExtendedDays);

    private bool CanExtend =>
        extendingBorrow != null
        && extendDays >= 1
        && extendDays <= MaxAvailableExtend;

    private DateTime? NewDeadline =>
        extendingBorrow?.Deadline?.AddDays(extendDays);

    #endregion

    #region Колонки

    private readonly List<DataGridColumn<RoomBookOption>> availableColumns = new()
    {
        new() { Title = "Книга", Value = o => o.BookTitle, Width = 300 },
        new() { Title = "Автор", Value = o => o.BookAuthor, Width = 180 },
        new() { Title = "Комната", Value = o => o.RoomName, Width = 160 },
        new()
        {
            Title = "Доступно",
            Width = 130,
            FilterKind = FilterKind.Number,
            Value = o => o.Available,
            FilterText = o => o.Available.ToString(),
            Template = item => b => b.AddContent(0, $"{item.Available} из {item.Total}")
        }
    };

    private List<DataGridColumn<BorrowedBookDTO>> historyColumns = new();

    #endregion

    #region Actions

    private List<DataGridAction<BorrowedBookDTO>>? _activeActions;
    private List<DataGridAction<BorrowedBookDTO>> activeActions => _activeActions ??= new()
    {
        new()
        {
            Label = "Продлить",
            Icon = "↻",
            MinSelection = 1,
            ShowInContextMenu = true,
            ShowInToolbar = true,
            CanExecute = s => s.Count == 1
                              && s[0].TotalExtendedDays < MaxExtendDeadlineDays,
            Handler = s => OpenExtend(s[0])
        },
        new()
        {
            Label = "Вернуть",
            Icon = "✓",
            MinSelection = 1,
            ShowInContextMenu = true,
            ShowInToolbar = true,
            SeparatorBefore = true,
            Handler = s => BulkReturnAsync(s)
        }
    };

    private List<DataGridAction<RoomBookOption>>? _availableActions;
    private List<DataGridAction<RoomBookOption>> availableActions => _availableActions ??= new()
    {
        new()
        {
            Label = "Выдать",
            Icon = "📖",
            MinSelection = 1,
            ShowInToolbar = true,
            ShowInContextMenu = true,
            CanExecute = s => s.Count == 1,
            Handler = s => OpenBorrowDialog(s[0])
        }
    };

    #endregion

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        actorRole = auth.User.IsInRole("Admin") ? UserRole.Admin
                  : auth.User.IsInRole("Librarian") ? UserRole.Librarian
                  : UserRole.Reader;

        settings = await SettingsService.GetAsync();

        historyColumns = UserBorrowsColumns.CreateHistory();

        _activeActions = null;
        _availableActions = null;

        await LoadAsync();
        await LoadCatalogAsync();
        isLoading = false;

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        try
        {
            var resp = await UserClient.GetUserByIdAsync(Id);
            user = resp.Users.FirstOrDefault();

            if (user == null)
            {
                errorMessage = "Пользователь не найден.";
                allBorrows = new();
                return;
            }

            var booksResp = await UserClient.GetUserBooksAsync(Id);
            allBorrows = booksResp.Books.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            user = null;
            allBorrows = new();
        }
    }

    private async Task LoadCatalogAsync()
    {
        try
        {
            var roomsResp = await RoomClient.GetAllRoomsAsync();
            rooms = roomsResp.Room.ToList();

            var booksResp = await BookClient.GetAllBooksAsync();
            bookById = booksResp.Book.ToDictionary(b => b.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки каталога: {ex.Message}";
        }
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        errorMessage = null;
        //statusMessage = null;
        await LoadAsync();
        await LoadCatalogAsync();
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        if (user == null || isLoading) return;

        var val = e.Value?.ToString();
        if (!Enum.TryParse<SubscriptionStatus>(val, out var newStatus)) return;

        if (newStatus == user.SubscriptionStatus) return;

        await ChangeStatusAsync(newStatus);
    }

    private async Task ChangeStatusAsync(SubscriptionStatus newStatus)
    {
        isLoading = true;
        try
        {
            var resp = await UserClient.ChangeStatusAsync(Id, newStatus);
            Toast.ShowSuccess(resp.Message);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка изменения статуса: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task OnActiveRowDoubleClick(BorrowedBookDTO b)
    {
        if (b.TotalExtendedDays < MaxExtendDeadlineDays)
            await OpenExtend(b);
    }

    // ---- Модалка редактирования ----
    private async Task OpenEditDialogAsync()
    {
        if (user == null || !CanEdit) return;

        dialogMode = DialogMode.Edit;
        draft = new UserDraft
        {
            LastName = user.LastName,
            FirstName = user.FirstName,
            MiddleName = user.MiddleName,
            ContactInfo = user.ContactInfo
        };
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        dialogMode = DialogMode.None;
        dialogError = null;
    }

    private async Task SaveAsync()
    {
        if (user == null) return;
        dialogError = null;
        try
        {
            await UserClient.UpdateUserAsync(new UpdateUserRequest
            {
                Id = new Id(user.Id),
                LastName = draft.LastName,
                FirstName = draft.FirstName,
                MiddleName = draft.MiddleName,
                ContactInfo = draft.ContactInfo
            });
            Toast.ShowSuccess($"Пользователь «{draft.LastName} {draft.FirstName}» обновлён");
            CloseDialog();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    // ---- Удаление ----
    private async Task DeleteUserAsync()
    {
        if (user == null || !CanDelete) return;

        if (user.ActiveBorrowedCount > 0)
        {
            Toast.ShowError($"Нельзя удалить: у пользователя {user.ActiveBorrowedCount} активных выдач.");
            return;
        }

        var confirmed = await Confirm.AskAsync(
            $"Удалить пользователя «{user.LastName} {user.FirstName}»?\n" +
            $"Email: {user.Email}\n\n" +
            "Пользователь пропадёт из списка и не сможет входить в систему, " +
            "но история выдач и штрафов сохранится.",
            title: "Удаление пользователя",
            confirmText: "Удалить",
            requireConfirmationWord: true);

        if (!confirmed) return;

        try
        {
            await UserClient.DeleteUserAsync(user.Id);
            Toast.ShowSuccess($"Пользователь «{user.LastName} {user.FirstName}» деактивирован");
            Nav.NavigateTo("/users");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка деактивации: {ex.Message}");
        }
    }

    // ---- Модалка выдачи ----
    private async Task OpenBorrowDialog(RoomBookOption book)
    {
        if (book == null) return;
        if (user == null) return;
        if (user.ActiveBorrowedCount >= MaxBooksPerUser) return;
        if (overdueCount > 0) return;

        borrowDialogOpen = true;
        borrowDialogBook = book;
        borrowDueDate = DateTime.Today.AddDays(14);
        borrowDialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseBorrowDialog()
    {
        borrowDialogOpen = false;
        borrowDialogBook = null;
        borrowDialogError = null;
    }

    private async Task SubmitBorrowAsync()
    {
        if (!CanSubmitBorrow || borrowDialogBook == null) return;
        borrowDialogError = null;
        try
        {
            var resp = await BorrowingClient.BorrowBookAsync(new BorrowBookRequest
            {
                UserId = Id,
                RoomBookId = borrowDialogBook.RoomBookId,
                BorrowDays = BorrowDaysComputed
            });
            Toast.ShowSuccess(resp.Message);
            CloseBorrowDialog();
            await LoadAsync();
            await LoadCatalogAsync();
        }
        catch (Exception ex)
        {
            borrowDialogError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    // ---- Возврат ----
    private async Task BulkReturnAsync(IReadOnlyList<BorrowedBookDTO> borrows)
    {
        if (borrows.Count == 0) return;

        if (borrows.Count == 1)
        {
            await OpenReturnDialog(borrows[0]);
            return;
        }

        var msg = $"Вернуть {borrows.Count} книг(и) без осмотра?\n\n" +
                  string.Join("\n", borrows.Select(b => $"• {b.BookTitle}")) +
                  "\n\nКниги будут приняты как «Ок». " +
                  "Для возврата с указанием причины списания верните книги по одной.";
        if (!await Confirm.AskAsync(msg, title: "Массовый возврат", confirmText: "Вернуть все"))
            return;

        var success = 0;
        var errors = new List<string>();

        foreach (var b in borrows)
        {
            try
            {
                await BorrowingClient.ReturnBookAsync(new ReturnBookRequest { UserRoomBookId = b.Id });
                success++;
            }
            catch (Exception ex)
            {
                errors.Add($"«{b.BookTitle}»: {ex.Message}");
            }
        }

        if (errors.Count > 0)
            Toast.ShowError($"Возвращено: {success}, ошибок: {errors.Count}.\n{string.Join("\n", errors)}");
        else if (success > 0)
            Toast.ShowSuccess($"Возвращено книг: {success}");

        await LoadAsync();
        await LoadCatalogAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenReturnDialog(BorrowedBookDTO borrow)
    {
        returnDialogBorrow = borrow;
        returnReason = null;
        returnCompensation = null;
        returnDialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseReturnDialog()
    {
        returnDialogBorrow = null;
        returnDialogError = null;
    }

    private void SetReturnReason(DiscardReason? reason)
    {
        returnReason = reason;
        if (reason == null)
            returnCompensation = null;
    }

    private void OnReturnReasonChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val))
        {
            SetReturnReason(null);
        }
        else if (Enum.TryParse<DiscardReason>(val, out var reason))
        {
            SetReturnReason(reason);
        }
    }

    private bool CanSubmitReturn =>
        returnDialogBorrow != null
        && !returnDialogSaving
        && (returnReason != DiscardReason.Loss
            || (returnCompensation.HasValue && returnCompensation.Value > 0));

    private async Task SubmitReturnAsync()
    {
        if (!CanSubmitReturn || returnDialogBorrow == null) return;

        returnDialogSaving = true;
        returnDialogError = null;
        try
        {
            var resp = await BorrowingClient.ReturnBookAsync(new ReturnBookRequest
            {
                UserRoomBookId = returnDialogBorrow.Id,
                DiscardReason = returnReason,
                CompensationAmount = returnCompensation
            });
            Toast.ShowSuccess(resp.Message);
            CloseReturnDialog();
            await LoadAsync();
            await LoadCatalogAsync();
        }
        catch (Exception ex)
        {
            returnDialogError = ex.Message;
        }
        finally
        {
            returnDialogSaving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ---- Продление ----
    private async Task OpenExtend(BorrowedBookDTO b)
    {
        extendingBorrow = b;
        extendDays = Math.Min(7, MaxAvailableExtend);
        if (extendDays < 1) extendDays = 1;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseExtend() => extendingBorrow = null;

    private async Task ExtendAsync()
    {
        if (!CanExtend || extendingBorrow == null) return;

        try
        {
            var resp = await BorrowingClient.ExtendDeadlineAsync(new ExtendDeadlineRequest
            {
                UserRoomBookId = extendingBorrow.Id,
                ExtraDays = extendDays
            });
            Toast.ShowSuccess(resp.Message);
            CloseExtend();

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Ошибка продления: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    private record RoomBookOption(Guid RoomBookId, string BookTitle, string BookAuthor,
                                  string RoomName, int Available, int Total)
    {
        public string Display => $"{RoomName} — {BookTitle} ({BookAuthor}), доступно {Available} из {Total}";
    }

