    // ---- Продление ----
    private int MaxAvailableExtend =>
        extendingBorrow == null ? 0
        : Math.Max(0, MaxExtendDeadlineDays - extendingBorrow.TotalExtendedDays);

    private bool CanExtend =>
        extendingBorrow != null
        && extendDays >= 1
        && extendDays <= MaxAvailableExtend;

    private DateTime? NewDeadline =>
        extendingBorrow?.Deadline?.AddDays(extendDays);

