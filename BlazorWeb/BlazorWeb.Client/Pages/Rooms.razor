@page "/rooms"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using BlazorWeb.Client.Services
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Records
@using LibApp.Core.Requests.Entities.Room
@inject IRoomApiClient ApiClient
@inject IBookApiClient BookApiClient
@inject IJSRuntime JS

<PageTitle>Комнаты</PageTitle>

<h1>Комнаты</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}

@if (isLoading)
{
    <p>Загрузка данных...</p>
}
else if (rooms != null)
{
    <DataGrid TItem="RoomDTO"
              Items="rooms"
              PageSize="10"
              Columns="columns"
              Actions="actions"
              StatusMessage="@statusMessage" />
}

@* Модалка: имя комнаты (Create/Edit) *@
@if (dialogMode != DialogMode.None)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>

    <div class="modal-dialog" @onclick:stopPropagation="true">
        <h3>@(dialogMode == DialogMode.Create ? "Новая комната" : "Редактирование комнаты")</h3>
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />
            <div class="mb-3">
                <label class="form-label">Название</label>
                <InputText @bind-Value="draft.Name" class="form-control" />
                <ValidationMessage For="() => draft.Name" class="text-danger" />
            </div>
            @if (!string.IsNullOrEmpty(dialogError))
            {
                <div class="alert alert-danger">@dialogError</div>
            }
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseDialog">Отмена</button>
        </EditForm>
    </div>
}

@* Модалка редактора книг комнаты *@
@if (booksEditorRoom != null)
{
    <div class="modal-backdrop" @onclick="CloseBooksEditor"></div>

    <div class="modal-dialog modal-dialog-wide" @onclick:stopPropagation="true">
        <h3>Книги в комнате «@booksEditorRoom.Name»</h3>

        @if (bookCatalog == null)
        {
            <p>Загрузка каталога книг...</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th style="width: 120px;">Количество</th>
                        <th style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (roomBooksDraft.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-muted">В комнате пока нет книг</td>
                        </tr>
                    }
                    @foreach (var rb in roomBooksDraft)
                    {
                        var local = rb;
                        <tr @key="local.BookId">
                            <td>@GetBookTitle(local.BookId)</td>
                            <td>
                                <InputNumber TValue="int" class="form-control"
                                             Value="local.BookCount"
                                             ValueChanged="v => ChangeCount(local, v)" />
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => RemoveFromRoom(local)">
                                    ✕
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (availableBooks.Count > 0)
            {
                <h5 class="mt-3">Добавить книгу</h5>
                <div class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label">Книга</label>
                        <select class="form-select" @bind="newBookId">
                            <option value="@Guid.Empty">— выберите —</option>
                            @foreach (var b in availableBooks)
                            {
                                <option value="@b.Id">@b.Title (@b.Author)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label">Кол-во</label>
                        <input type="number" class="form-control" min="1" @bind="newBookCount" style="width: 100px;" />
                    </div>
                    <div class="col-auto">
                        <button type="button" class="btn btn-primary"
                                disabled="@(newBookId == Guid.Empty || newBookCount <= 0)"
                                @onclick="AddBookToRoom">
                            Добавить
                        </button>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted mt-3">Все книги из каталога уже добавлены в комнату.</p>
            }

            @if (!string.IsNullOrEmpty(booksEditorError))
            {
                <div class="alert alert-danger mt-3">@booksEditorError</div>
            }

            <div class="mt-3">
                <button type="button" class="btn btn-primary" @onclick="SaveBooksAsync">Сохранить</button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="CloseBooksEditor">Отмена</button>
            </div>
        }
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        cursor: default; /* Изменено с pointer на default */
    }

    .modal-dialog {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
        background: #fff;
        border-radius: 8px;
        padding: 20px 24px;
        min-width: 420px;
        max-width: 90vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        pointer-events: auto;
    }

    .modal-dialog-wide {
        min-width: 600px;
    }
</style>

@code {
    private List<RoomDTO>? rooms;
    private bool isLoading = true;
    private string? errorMessage;
    private string? statusMessage;

    private enum DialogMode { None, Create, Edit }
    private DialogMode dialogMode = DialogMode.None;
    private Guid? editingId;
    private RoomDraft draft = new();
    private string? dialogError;

    // books editor state
    private RoomDTO? booksEditorRoom;
    private List<BookDTO>? bookCatalog;
    private List<RoomBookDTO> roomBooksDraft = new();
    private Guid newBookId = Guid.Empty;
    private int newBookCount = 1;
    private string? booksEditorError;

    private readonly List<DataGridColumn<RoomDTO>> columns = new()
    {
        new() { Title = "Название", Value = r => r.Name, Width = 300 },
        new()
        {
            Title = "Книг",
            Value = r => r.RoomBook?.Sum(rb => rb.BookCount) ?? 0,
            FilterKind = FilterKind.Number,
            Width = 100
        }
    };

    private List<DataGridAction<RoomDTO>> actions = new();

    private List<BookDTO> availableBooks =>
        bookCatalog?.Where(b => roomBooksDraft.All(rb => rb.BookId != b.Id)).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        ConfigureActions();
        await LoadAsync();
    }

    private void ConfigureActions()
    {
        actions = new()
        {
            new()
            {
                Label = "Добавить",
                Icon = "➕",
                MinSelection = 0,
                ShowInContextMenu = false,
                Handler = _ => OpenCreateDialogAsync()
            },
            new()
            {
                Label = "Переименовать",
                Icon = "✏️",
                CanExecute = s => s.Count == 1,
                Handler = s => OpenEditDialogAsync(s[0])
            },
            new()
            {
                Label = "Книги",
                Icon = "📚",
                CanExecute = s => s.Count == 1,
                ShowInContextMenu = true,
                Handler = s => OpenBooksEditorAsync(s[0])
            },
            new()
            {
                Label = "Удалить",
                Icon = "🗑️",
                SeparatorBefore = true,
                CanExecute = s => s.Count == 1,
                Handler = s => DeleteAsync(s[0])
            }
        };
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var resp = await ApiClient.GetAllRoomsAsync();
            rooms = resp.Room.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // name dialog

    private async Task OpenCreateDialogAsync()
    {
        dialogMode = DialogMode.Create;
        editingId = null;
        draft = new RoomDraft();
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditDialogAsync(RoomDTO room)
    {
        dialogMode = DialogMode.Edit;
        editingId = room.Id;
        draft = new RoomDraft { Name = room.Name };
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        dialogMode = DialogMode.None;
        editingId = null;
        dialogError = null;
    }

    private async Task SaveAsync()
    {
        dialogError = null;
        try
        {
            if (dialogMode == DialogMode.Create)
            {
                await ApiClient.CreateRoomAsync(new CreateRoomRequest(draft.Name, []));
                statusMessage = $"Комната «{draft.Name}» добавлена";
            }
            else if (dialogMode == DialogMode.Edit && editingId.HasValue)
            {
                // берём текущие RoomBook без изменений — переименование не должно трогать книги
                var room = rooms?.FirstOrDefault(r => r.Id == editingId.Value);
                var books = room?.RoomBook.ToList() ?? new();

                await ApiClient.UpdateRoomAsync(new UpdateRoomRequest
                {
                    Id = new Id(editingId.Value),
                    Name = draft.Name,
                    RoomBookDTO = books
                });
                statusMessage = $"Комната «{draft.Name}» обновлена";
            }
            CloseDialog();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    // books editor

    private async Task OpenBooksEditorAsync(RoomDTO room)
    {
        booksEditorRoom = room;
        roomBooksDraft = room.RoomBook.ToList();
        newBookId = Guid.Empty;
        newBookCount = 1;
        booksEditorError = null;
        bookCatalog = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var resp = await BookApiClient.GetAllBooksAsync();
            bookCatalog = resp.Book.ToList();
        }
        catch (Exception ex)
        {
            booksEditorError = $"Не удалось загрузить каталог книг: {ex.Message}";
            bookCatalog = new();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void CloseBooksEditor()
    {
        booksEditorRoom = null;
        roomBooksDraft = new();
        booksEditorError = null;
    }

    private string GetBookTitle(Guid bookId)
        => bookCatalog?.FirstOrDefault(b => b.Id == bookId)?.Title ?? $"[{bookId}]";

    private void ChangeCount(RoomBookDTO rb, int newCount)
    {
        if (newCount < 0) newCount = 0;
        var idx = roomBooksDraft.FindIndex(x => x.BookId == rb.BookId);
        if (idx < 0) return;
        roomBooksDraft[idx] = rb with { BookCount = newCount };
    }

    private void RemoveFromRoom(RoomBookDTO rb)
    {
        roomBooksDraft.RemoveAll(x => x.BookId == rb.BookId);
    }

    private void AddBookToRoom()
    {
        if (newBookId == Guid.Empty || newBookCount <= 0) return;
        if (roomBooksDraft.Any(rb => rb.BookId == newBookId)) return;

        roomBooksDraft.Add(new RoomBookDTO(
            Id: Guid.Empty,                         // новая запись => сервер создаст
            RoomId: booksEditorRoom!.Id,
            BookId: newBookId,
            BookCount: newBookCount));

        newBookId = Guid.Empty;
        newBookCount = 1;
    }

    private async Task SaveBooksAsync()
    {
        booksEditorError = null;
        try
        {
            await ApiClient.UpdateRoomAsync(new UpdateRoomRequest
            {
                Id = new Id(booksEditorRoom!.Id),
                Name = booksEditorRoom.Name,        // имя не меняется
                RoomBookDTO = roomBooksDraft
            });
            statusMessage = $"Книги комнаты «{booksEditorRoom.Name}» обновлены";
            CloseBooksEditor();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            booksEditorError = ex.Message;
        }
    }

    // delete

    private async Task DeleteAsync(RoomDTO room)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Удалить комнату «{room.Name}»?");
        if (!confirmed) return;

        try
        {
            await ApiClient.DeleteRoomAsync(room.Id);
            statusMessage = $"Комната «{room.Name}» удалена";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка удаления: {ex.Message}";
        }
    }

    private class RoomDraft
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Название обязательно")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Не более 100 символов")]
        public string Name { get; set; } = "";
    }
}