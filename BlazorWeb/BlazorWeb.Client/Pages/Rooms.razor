@page "/rooms"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using BlazorWeb.Client.Services.Interfaces
@using BlazorWeb.Components.Shared.DataGrid
@using LibApp.Core.DTO.Entities
@using LibApp.Core.Requests.Entities.Room
@inject IRoomApiClient ApiClient
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Комнаты</PageTitle>

<h1>Комнаты</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}

@if (isLoading)
{
    <p>Загрузка данных...</p>
}
else if (rooms != null)
{
    <DataGrid TItem="RoomDTO"
              Items="rooms"
              PageSize="10"
              Columns="columns"
              Actions="actions"
              StatusMessage="@statusMessage"
              OnRowDoubleClick="OnRoomDoubleClick" />
}

@* Модалка создания комнаты *@
@if (dialogMode == DialogMode.Create)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>
    <div class="modal-dialog" @onclick:stopPropagation="true">
        <h3>Новая комната</h3>
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Название</label>
                <InputText @bind-Value="draft.Name" class="form-control" />
                <ValidationMessage For="() => draft.Name" class="text-danger" />
            </div>
            @if (!string.IsNullOrWhiteSpace(dialogError))
            {
                <div class="alert alert-danger mb-3" style="white-space: pre-line;">@dialogError</div>
            }
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="CloseDialog">Отмена</button>
        </EditForm>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        cursor: default;
    }

    .modal-dialog {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1001;
        background: #fff;
        border-radius: 8px;
        padding: 20px 24px;
        min-width: 420px;
        max-width: 90vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        pointer-events: auto;
    }
</style>

@code {
    private List<RoomDTO>? rooms;
    private bool isLoading = true;
    private string? errorMessage;
    private string? statusMessage;

    private enum DialogMode { None, Create }
    private DialogMode dialogMode = DialogMode.None;
    private RoomDraft draft = new();
    private string? dialogError;

    private readonly List<DataGridColumn<RoomDTO>> columns = new()
    {
        new() { Title = "Название", Value = r => r.Name, Width = 300 },
        new() { Title = "Книг", Value = r => r.RoomBook?.Sum(rb => rb.BookCount) ?? 0, FilterKind = FilterKind.Number, Width = 100 }
    };

    private List<DataGridAction<RoomDTO>> actions = new();

    private bool isEditor;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        isEditor = auth.User.IsInRole("Librarian") || auth.User.IsInRole("Admin");

        ConfigureActions();
        await LoadAsync();
    }
    private void ConfigureActions()
    {
        if (!isEditor)
        {
            actions = new(); // пусто = нет кнопок
            return;
        }

        actions = new()
        {
            new() { Label = "Добавить", Icon = "➕", MinSelection = 0, ShowInContextMenu = false, Handler = _ => OpenCreateDialogAsync() },
            new() { Label = "Открыть", Icon = "📖", CanExecute = s => s.Count == 1, Handler = s => { Nav.NavigateTo($"/rooms/{s[0].Id}"); return Task.CompletedTask; } }
        };
    }

    private void OnRoomDoubleClick(RoomDTO room) => Nav.NavigateTo($"/rooms/{room.Id}");

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var resp = await ApiClient.GetAllRoomsAsync();
            rooms = resp.Room.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        dialogMode = DialogMode.Create;
        draft = new RoomDraft();
        dialogError = null;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        dialogMode = DialogMode.None;
        dialogError = null;
    }

    private async Task SaveAsync()
    {
        dialogError = null;
        try
        {
            await ApiClient.CreateRoomAsync(new CreateRoomRequest(draft.Name, []));
            statusMessage = $"Комната «{draft.Name}» добавлена";
            CloseDialog();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            dialogError = ex.Message;
        }
    }

    private class RoomDraft
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Название обязательно")]
        [System.ComponentModel.DataAnnotations.StringLength(100, ErrorMessage = "Не более 100 символов")]
        public string Name { get; set; } = "";
    }
}