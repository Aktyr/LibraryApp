@using Microsoft.AspNetCore.Identity
@using BlazorWeb.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

<div class="list-group list-group-flush">
    <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1" href="Account/Manage" Match="NavLinkMatch.All">
        👤 Профиль (Имя/Телефон)
    </NavLink>
    <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1" href="Account/Manage/Email">
        📧 Email
    </NavLink>
    <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1" href="Account/Manage/ChangePassword">
        🔑 Сменить пароль
    </NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1" href="Account/Manage/ExternalLogins">
            🔗 Внешние входы
        </NavLink>
    }
    <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1" href="Account/Manage/TwoFactorAuthentication">
        🛡️ Двухфакторная аутентификация
    </NavLink>
    <NavLink class="list-group-item list-group-item-action border-0 rounded mb-1" href="Account/Manage/PersonalData">
        📦 Личные данные
    </NavLink>

    <div class="mt-3 pt-3 border-top">
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
            <button type="submit" class="btn btn-outline-danger w-100">
                🚪 Выйти из аккаунта
            </button>
        </form>
    </div>
</div>

@code {
    private bool hasExternalLogins;
    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }
}