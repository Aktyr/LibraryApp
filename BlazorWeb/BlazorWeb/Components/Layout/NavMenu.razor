@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row px-2">
    <a class="navbar-brand" href="">
        <span class="brand-icon">📚</span><span class="brand-text">LibraryApp</span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column mt-2">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-emoji">🏠</span><span class="nav-text">Главная</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (context.User.IsInRole("Librarian") || context.User.IsInRole("Admin"))
                {
                    <div class="nav-section-title">Библиотека</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="books">
                            <span class="nav-emoji">📚</span><span class="nav-text">Книги</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="rooms">
                            <span class="nav-emoji">🚪</span><span class="nav-text">Комнаты</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="users">
                            <span class="nav-emoji">👥</span><span class="nav-text">Пользователи</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="reports">
                            <span class="nav-emoji">📊</span><span class="nav-text">Отчёты</span>
                        </NavLink>
                    </div>
                }

                <div class="nav-section-title">Аккаунт</div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="my-profile">
                        <span class="nav-emoji">👤</span><span class="nav-text">Мой профиль</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="nav-emoji">⚙️</span><span class="nav-text">Настройки</span>
                    </NavLink>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="nav-emoji">🔑</span><span class="nav-text">Вход</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}