<Window x:Class="LibraryApp.WPF_CustomControls.WindowBookCount" x:Name="This"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp.WPF_CustomControls"
        xmlns:behaviors="clr-namespace:LibraryApp.WPF_CustomControls"
        
        behaviors:WindowBehaviors.CloseOnEsc="True"
        
        mc:Ignorable="d"
        Title="WindowBookCount" Height="450" Width="800">
    <Window.Resources>
        <local:NullToFalseConverter x:Key="NullToFalseConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>

        </Grid.RowDefinitions>

        <DataGrid Grid.RowSpan="1" Margin="20,20,20,20"
                  x:Name="dataGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  ItemsSource="{Binding RoomBooksList, Mode=OneWay}"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionMode="Single">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Комната" Binding="{Binding RoomName, ElementName=This}" />
                <DataGridTextColumn Header="Книга" Binding="{Binding Book.Name}" />
                <DataGridTextColumn Header="Автор" Binding="{Binding Book.Autor}" />
                <DataGridTextColumn Header="Год" Binding="{Binding Book.Year}" />
                <DataGridTextColumn Header="Количество на складе" Binding="{Binding BookCount}" />
                
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Grid.Row="1" Margin="-10,20,5,5">

            <Button  HorizontalAlignment="Stretch" Padding="0, 5" Margin="0, 0, 0, 5"
                     Content="[Enter] Сохранить изменения" Click="SaveButton_Click"
                     behaviors:SmartButtonFocus.SmartFocus="True"/>

            <Separator Margin="0, 0, 0, 5" />

            <Button  HorizontalAlignment="Stretch" Padding="0, 5" Margin="0, 0, 0, 5"
                     Content="Добавить новую книгу" Click="NewBookButton_Click"/>
            
            <Button HorizontalAlignment="Stretch" Padding="0, 5" Margin="0, 0, 0, 5" 
                    Content="Добавить книгу в комнату" Click="AddBookButton_Click" 
                    IsEnabled="{Binding ElementName=dataGrid, Path=SelectedItem, Converter={StaticResource NullToFalseConverter}}"/>

            <Separator Margin="0, 0, 0, 5" />

            <Button HorizontalAlignment="Stretch" Padding="0, 5" Margin="0, 0, 0, 5" 
                    Content="Удалить" Click="DeleteBookButton_Click" 
                    IsEnabled="{Binding ElementName=dataGrid, Path=SelectedItem, Converter={StaticResource NullToFalseConverter}}"/>

            <Button HorizontalAlignment="Stretch" Padding="0, 5" Margin="0, 0, 0, 5" 
                    Content="Редактировать" Click="EditBookButton_Click" 
                    IsEnabled="{Binding ElementName=dataGrid, Path=SelectedItem, Converter={StaticResource NullToFalseConverter}}"/>



        </StackPanel>

    </Grid>
</Window>
